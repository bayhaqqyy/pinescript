// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// Strategy: XAU QUANTUM SIGNAL
// Optimized strictly for Gold (XAUUSD) volatility.

//@version=6
indicator("XAU QUANTUM SIGNAL", overlay=true, max_bars_back=500)

// --- INPUTS ---
emaFastLen  = input.int(9,  "EMA Fast", minval=2, group="EMA Crossover")
emaSlowLen  = input.int(21, "EMA Slow", minval=2, group="EMA Crossover")
emaTrendLen = input.int(200, "EMA Trend (Macro)", minval=50, group="EMA Crossover")

macdFast   = input.int(12, "MACD Fast",   minval=1, group="MACD")
macdSlow   = input.int(26, "MACD Slow",   minval=1, group="MACD")
macdSignal = input.int(9,  "MACD Signal", minval=1, group="MACD")

rsiLen     = input.int(14, "RSI Length", group="RSI Filter")
rsiMaxBuy  = input.int(65, "Max RSI BUY", group="RSI Filter", tooltip="Gold gampang koreksi, dibatasi di 65")
rsiMinSell = input.int(35, "Min RSI SELL", group="RSI Filter", tooltip="Dibatasi di 35")

atrPeriod  = input.int(14,    "ATR Period", minval=1, group="ATR Levels")
atrMultTP1 = input.float(1.0, "ATR Mult TP1", minval=0.1, step=0.1, group="ATR Levels", tooltip="Ambil TP1 lebih cepat di Gold")
atrMultTP2 = input.float(2.0, "ATR Mult TP2", minval=0.1, step=0.1, group="ATR Levels")
atrMultSL  = input.float(2.0, "ATR Mult SL",  minval=0.1, step=0.1, group="ATR Levels")

// --- CALCULATIONS ---
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)

emaCrossUp   = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)

[_, _, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
rsiValue = ta.rsi(close, rsiLen)
atrValue = ta.atr(atrPeriod)
signalReady = bar_index >= (atrPeriod > emaTrendLen ? atrPeriod : emaTrendLen)

// --- SIGNALS ---
buySignal  = barstate.isconfirmed and signalReady and emaCrossUp and macdHist > 0 and close > emaTrend and rsiValue < rsiMaxBuy
sellSignal = barstate.isconfirmed and signalReady and emaCrossDown and macdHist < 0 and close < emaTrend and rsiValue > rsiMinSell

// --- LEVELS ---
entryPrice = close
buyTP1 = entryPrice + atrMultTP1 * atrValue
buyTP2 = entryPrice + atrMultTP2 * atrValue
buySL  = entryPrice - atrMultSL  * atrValue

sellTP1 = entryPrice - atrMultTP1 * atrValue
sellTP2 = entryPrice - atrMultTP2 * atrValue
sellSL  = entryPrice + atrMultSL  * atrValue

tp1Level = buySignal ? buyTP1 : sellTP1
tp2Level = buySignal ? buyTP2 : sellTP2
slLevel  = buySignal ? buySL  : sellSL

// --- VISUALS ---
plotshape(buySignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="BUY")
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,  0), size=size.small, text="SELL")
plot(emaFast, color=color.new(color.aqua, 0))
plot(emaSlow, color=color.new(color.orange, 0))
plot(emaTrend, color=color.new(color.yellow, 30), linewidth=2) // Warna emas/kuning untuk XAU

// --- ALERT PAYLOAD (GOLD) ---
if buySignal or sellSignal
    actionStr  = buySignal ? "BUY" : "SELL"
    contextRaw = actionStr + " — EMA " + str.tostring(emaFastLen) + (buySignal ? " cross UP, Trend UP, RSI:" : " cross DOWN, Trend DOWN, RSI:") + str.tostring(math.round(rsiValue))
    
    // Header menggunakan icon medali dan label XAU
    alertMsg = "🥇 XAU QUANTUM SIGNAL\n" +
               "Ticker: "  + syminfo.ticker + "\n" +
               "Action: "  + actionStr + "\n" +
               "Entry: "   + str.tostring(entryPrice, format.mintick) + "\n" +
               "TP1: "     + str.tostring(tp1Level,   format.mintick) + "\n" +
               "TP2: "     + str.tostring(tp2Level,   format.mintick) + "\n" +
               "SL: "      + str.tostring(slLevel,    format.mintick) + "\n" +
               "Context: " + contextRaw

    alert(alertMsg, alert.freq_once_per_bar_close)