[now8, sup8, rst8, entry8, tp_8, sl_8, pctTp8, profit8, status8, zona8, rsi8, srsi8, macd8, rvolPct8, valueBar8, bandar8, action8, score8, signal8] = request.security(tk8, tf, f_dashboard_engine("BANDAR"))
[now9, sup9, rst9, entry9, tp_9, sl_9, pctTp9, profit9, status9, zona9, rsi9, srsi9, macd9, rvolPct9, valueBar9, bandar9, action9, score9, signal9] = request.security(tk9, tf, f_dashboard_engine("BANDAR"))
[now10, sup10, rst10, entry10, tp_10, sl_10, pctTp10, profit10, status10, zona10, rsi10, srsi10, macd10, rvolPct10, valueBar10, bandar10, action10, score10, signal10] = request.security(tk10, tf, f_dashboard_engine("BANDAR"))

