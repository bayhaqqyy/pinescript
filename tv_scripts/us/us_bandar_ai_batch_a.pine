[now6, sup6, rst6, entry6, tp_6, sl_6, pctTp6, profit6, status6, zona6, rsi6, srsi6, macd6, rvolPct6, valueBar6, bandar6, action6, score6, signal6] = request.security(tk6, tf, f_dashboard_engine("BANDAR"))
