// ============================================================================
[now1, sup1, rst1, entry1, tp_1, sl_1, pctTp1, profit1, status1, zona1, rsi1, srsi1, macd1, rvolPct1, valueBar1, bandar1, action1, score1, signal1] = request.security(tk1, tf, f_dashboard_engine("BANDAR"))
[now2, sup2, rst2, entry2, tp_2, sl_2, pctTp2, profit2, status2, zona2, rsi2, srsi2, macd2, rvolPct2, valueBar2, bandar2, action2, score2, signal2] = request.security(tk2, tf, f_dashboard_engine("BANDAR"))
