    table.cell(tbl, 4, 9, sig9, text_color=color.black, bgcolor=f_sig_bg(sig9, c9 > ema20_9 and ema20_9 > ema50_9, c9 < ema20_9 and ema20_9 < ema50_9), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 10, "BAC", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 10, "$" + str.tostring(c10, "#.##") + " (" + str.tostring(chg10, "#.##") + "%)", text_color=chg10 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 10, dvol10 > 1e6 ? "$" + str.tostring(dvol10/1e6, "#.#") + "M" : "$" + str.tostring(dvol10/1e3, "#.#") + "K", text_color=dvol10 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 10, "R:" + str.tostring(rsi10, "#.#") + " V:" + str.tostring(rvol10, "#.#") + "x", text_color=rsi10 < 30 ? color.lime : rsi10 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 10, sig10, text_color=color.black, bgcolor=f_sig_bg(sig10, c10 > ema20_10 and ema20_10 > ema50_10, c10 < ema20_10 and ema20_10 < ema50_10), text_size=size.small, text_halign=text.align_center)

// ============================================================================
// ALERTS — Human-readable text
// ============================================================================
if barstate.islast and barstate.isconfirmed
    if sig1 != "WAIT"
        msg_1 = "🚨 US SWING HUNTER\nTicker: BTG\nPrice: $" + str.tostring(c1, "#.##") + " (" + str.tostring(chg1, "#.##") + "%)\nSignal: " + sig1 + "\nRSI: " + str.tostring(rsi1, "#.#") + " | R.Vol: " + str.tostring(rvol1, "#.#") + "x"
        alert(msg_1, alert.freq_once_per_bar_close)
    if sig2 != "WAIT"
        msg_2 = "🚨 US SWING HUNTER\nTicker: HL\nPrice: $" + str.tostring(c2, "#.##") + " (" + str.tostring(chg2, "#.##") + "%)\nSignal: " + sig2 + "\nRSI: " + str.tostring(rsi2, "#.#") + " | R.Vol: " + str.tostring(rvol2, "#.#") + "x"
        alert(msg_2, alert.freq_once_per_bar_close)
    if sig3 != "WAIT"
        msg_3 = "🚨 US SWING HUNTER\nTicker: FSM\nPrice: $" + str.tostring(c3, "#.##") + " (" + str.tostring(chg3, "#.##") + "%)\nSignal: " + sig3 + "\nRSI: " + str.tostring(rsi3, "#.#") + " | R.Vol: " + str.tostring(rvol3, "#.#") + "x"
        alert(msg_3, alert.freq_once_per_bar_close)
    if sig4 != "WAIT"
        msg_4 = "🚨 US SWING HUNTER\nTicker: CDE\nPrice: $" + str.tostring(c4, "#.##") + " (" + str.tostring(chg4, "#.##") + "%)\nSignal: " + sig4 + "\nRSI: " + str.tostring(rsi4, "#.#") + " | R.Vol: " + str.tostring(rvol4, "#.#") + "x"
        alert(msg_4, alert.freq_once_per_bar_close)
    if sig5 != "WAIT"
        msg_5 = "🚨 US SWING HUNTER\nTicker: ABEV\nPrice: $" + str.tostring(c5, "#.##") + " (" + str.tostring(chg5, "#.##") + "%)\nSignal: " + sig5 + "\nRSI: " + str.tostring(rsi5, "#.#") + " | R.Vol: " + str.tostring(rvol5, "#.#") + "x"
        alert(msg_5, alert.freq_once_per_bar_close)
    if sig6 != "WAIT"
        msg_6 = "🚨 US SWING HUNTER\nTicker: ITUB\nPrice: $" + str.tostring(c6, "#.##") + " (" + str.tostring(chg6, "#.##") + "%)\nSignal: " + sig6 + "\nRSI: " + str.tostring(rsi6, "#.#") + " | R.Vol: " + str.tostring(rvol6, "#.#") + "x"
        alert(msg_6, alert.freq_once_per_bar_close)
    if sig7 != "WAIT"
        msg_7 = "🚨 US SWING HUNTER\nTicker: BBD\nPrice: $" + str.tostring(c7, "#.##") + " (" + str.tostring(chg7, "#.##") + "%)\nSignal: " + sig7 + "\nRSI: " + str.tostring(rsi7, "#.#") + " | R.Vol: " + str.tostring(rvol7, "#.#") + "x"
        alert(msg_7, alert.freq_once_per_bar_close)
    if sig8 != "WAIT"
