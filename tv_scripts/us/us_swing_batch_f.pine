// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// Generated on 2026-05-15 | Strategy: US SWING HUNTER v2
//
// @description US Stock swing trading screener for GoTrade users.
//   Default Timeframe: 15 menit. Holding period: 2-10 hari (swing).
//   Strategi: EMA 20/50 Trend + 20-bar Breakout + Volume Spike + RSI.
//   CHG% dihitung dari Daily Close secara organik (ta.change) agar sinkron dengan GoTrade.
//   Sinyal: BREAKOUT BUY, BULL ABSORB, DISTRIBUTION, BEAR ABSORB.
//   ⚠️ PDT Rule: Max 3 day trades per 5 hari jika account < $25K.

//@version=6
indicator("US SWING HUNTER v2 - BATCH F (10 Tickers)", overlay=true, max_bars_back=500)

// ============================================================================
// INPUT
// ============================================================================
tf         = input.timeframe("15", "Timeframe Screener")
emaLen     = input.int(200, "EMA Trend Length")
volMult    = input.float(1.5, "Vol Spike Multiplier")
pos        = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// ============================================================================
// TICKER DEFINITIONS (prices as of 2026-05-15)
// ============================================================================
tk1 = "NYSE:BTG"  // ~$3.80
tk2 = "NYSE:HL"  // ~$4.50
tk3 = "NYSE:FSM"  // ~$3.45
tk4 = "NYSE:CDE"  // ~$3.20
tk5 = "NYSE:ABEV"  // ~$2.50
tk6 = "NYSE:ITUB"  // ~$6.80
tk7 = "NYSE:BBD"  // ~$2.30
tk8 = "NASDAQ:ERIC"  // ~$7.50
tk9 = "NYSE:F"  // ~$9.80
tk10 = "NYSE:BAC"  // ~$45.00

// ============================================================================
// CORE SWING ENGINE FUNCTION (8 return values)
// ============================================================================
f_swing_engine(ema_len, vol_mult) =>
    // Tangkap Harga Penutupan Harian (Daily Close) secara organik
    var float prevDailyClose = na
    if ta.change(time("D")) != 0
        prevDailyClose := close[1]

    baseClose = na(prevDailyClose) ? close[1] : prevDailyClose
    chgPct = baseClose > 0 ? (close - baseClose) / baseClose * 100 : 0.0

    ema20  = ta.ema(close, 20)
    ema50  = ta.ema(close, 50)
    emaSlow = ta.ema(close, ema_len)

    bullTrend = close > emaSlow and ema20 > ema50
    bearTrend = close < emaSlow and ema20 < ema50

    volMA = ta.sma(volume, 20)
    volSpike = volume > volMA * vol_mult
    rvol = volMA > 0 ? volume / volMA : 0.0
    dollarVol = volume * close

    rsi = ta.rsi(close, 14)

    highest20 = ta.highest(high, 20)
    breakout = close > highest20[1] and volSpike

    body = math.abs(close - open)
    lowerWick = math.min(open, close) - low
    upperWick = high - math.max(open, close)

    bullAbsorb = lowerWick > body * 1.5 and volSpike and close > open
    bearAbsorb = upperWick > body * 1.5 and volSpike and close < open

    status = breakout and bullTrend ? "BREAKOUT BUY" :
             bullAbsorb and bullTrend ? "BULL ABSORB" :
             bearAbsorb and bearTrend ? "BEAR ABSORB" :
             bearTrend and volSpike and close < open ? "DISTRIBUTION" : "WAIT"

    [close, status, rsi, ema20, ema50, rvol, dollarVol, chgPct]

// ============================================================================
// DATA FETCH — Engine (10 calls total, limit: 40) ✓
// ============================================================================
[c1, sig1, rsi1, ema20_1, ema50_1, rvol1, dvol1, chg1] = request.security(tk1, tf, f_swing_engine(emaLen, volMult))
[c2, sig2, rsi2, ema20_2, ema50_2, rvol2, dvol2, chg2] = request.security(tk2, tf, f_swing_engine(emaLen, volMult))
[c3, sig3, rsi3, ema20_3, ema50_3, rvol3, dvol3, chg3] = request.security(tk3, tf, f_swing_engine(emaLen, volMult))
[c4, sig4, rsi4, ema20_4, ema50_4, rvol4, dvol4, chg4] = request.security(tk4, tf, f_swing_engine(emaLen, volMult))
[c5, sig5, rsi5, ema20_5, ema50_5, rvol5, dvol5, chg5] = request.security(tk5, tf, f_swing_engine(emaLen, volMult))
[c6, sig6, rsi6, ema20_6, ema50_6, rvol6, dvol6, chg6] = request.security(tk6, tf, f_swing_engine(emaLen, volMult))
[c7, sig7, rsi7, ema20_7, ema50_7, rvol7, dvol7, chg7] = request.security(tk7, tf, f_swing_engine(emaLen, volMult))
[c8, sig8, rsi8, ema20_8, ema50_8, rvol8, dvol8, chg8] = request.security(tk8, tf, f_swing_engine(emaLen, volMult))
[c9, sig9, rsi9, ema20_9, ema50_9, rvol9, dvol9, chg9] = request.security(tk9, tf, f_swing_engine(emaLen, volMult))
[c10, sig10, rsi10, ema20_10, ema50_10, rvol10, dvol10, chg10] = request.security(tk10, tf, f_swing_engine(emaLen, volMult))

// ============================================================================
// TABLE DISPLAY (Compact 5-Column Layout)
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left
var tbl = table.new(tbl_pos, 5, 11, border_width=1, border_color=#30363d)

// Trend-aware signal background color
f_sig_bg(sig, isBull, isBear) =>
    sig == "BREAKOUT BUY" ? color.lime : sig == "BULL ABSORB" ? color.aqua : sig == "BEAR ABSORB" ? color.orange : sig == "DISTRIBUTION" ? color.red : isBull ? #1a3a1a : isBear ? #3a1a1a : color.gray

if barstate.islast
    hdr_bg = #8b5cf6
    hdr_clr = color.white
    table.cell(tbl, 0, 0, "TICKER", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 0, "PRICE", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 0, "$VOL", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 0, "MOMENTUM", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 0, "SIGNAL", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small, text_halign=text.align_center)

if barstate.islast
    table.cell(tbl, 0, 1, "BTG", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 1, "$" + str.tostring(c1, "#.##") + " (" + str.tostring(chg1, "#.##") + "%)", text_color=chg1 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 1, dvol1 > 1e6 ? "$" + str.tostring(dvol1/1e6, "#.#") + "M" : "$" + str.tostring(dvol1/1e3, "#.#") + "K", text_color=dvol1 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 1, "R:" + str.tostring(rsi1, "#.#") + " V:" + str.tostring(rvol1, "#.#") + "x", text_color=rsi1 < 30 ? color.lime : rsi1 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 1, sig1, text_color=color.black, bgcolor=f_sig_bg(sig1, c1 > ema20_1 and ema20_1 > ema50_1, c1 < ema20_1 and ema20_1 < ema50_1), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 2, "HL", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 2, "$" + str.tostring(c2, "#.##") + " (" + str.tostring(chg2, "#.##") + "%)", text_color=chg2 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 2, dvol2 > 1e6 ? "$" + str.tostring(dvol2/1e6, "#.#") + "M" : "$" + str.tostring(dvol2/1e3, "#.#") + "K", text_color=dvol2 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 2, "R:" + str.tostring(rsi2, "#.#") + " V:" + str.tostring(rvol2, "#.#") + "x", text_color=rsi2 < 30 ? color.lime : rsi2 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 2, sig2, text_color=color.black, bgcolor=f_sig_bg(sig2, c2 > ema20_2 and ema20_2 > ema50_2, c2 < ema20_2 and ema20_2 < ema50_2), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 3, "FSM", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 3, "$" + str.tostring(c3, "#.##") + " (" + str.tostring(chg3, "#.##") + "%)", text_color=chg3 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 3, dvol3 > 1e6 ? "$" + str.tostring(dvol3/1e6, "#.#") + "M" : "$" + str.tostring(dvol3/1e3, "#.#") + "K", text_color=dvol3 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 3, "R:" + str.tostring(rsi3, "#.#") + " V:" + str.tostring(rvol3, "#.#") + "x", text_color=rsi3 < 30 ? color.lime : rsi3 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 3, sig3, text_color=color.black, bgcolor=f_sig_bg(sig3, c3 > ema20_3 and ema20_3 > ema50_3, c3 < ema20_3 and ema20_3 < ema50_3), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 4, "CDE", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 4, "$" + str.tostring(c4, "#.##") + " (" + str.tostring(chg4, "#.##") + "%)", text_color=chg4 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 4, dvol4 > 1e6 ? "$" + str.tostring(dvol4/1e6, "#.#") + "M" : "$" + str.tostring(dvol4/1e3, "#.#") + "K", text_color=dvol4 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 4, "R:" + str.tostring(rsi4, "#.#") + " V:" + str.tostring(rvol4, "#.#") + "x", text_color=rsi4 < 30 ? color.lime : rsi4 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 4, sig4, text_color=color.black, bgcolor=f_sig_bg(sig4, c4 > ema20_4 and ema20_4 > ema50_4, c4 < ema20_4 and ema20_4 < ema50_4), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 5, "ABEV", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 5, "$" + str.tostring(c5, "#.##") + " (" + str.tostring(chg5, "#.##") + "%)", text_color=chg5 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 5, dvol5 > 1e6 ? "$" + str.tostring(dvol5/1e6, "#.#") + "M" : "$" + str.tostring(dvol5/1e3, "#.#") + "K", text_color=dvol5 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 5, "R:" + str.tostring(rsi5, "#.#") + " V:" + str.tostring(rvol5, "#.#") + "x", text_color=rsi5 < 30 ? color.lime : rsi5 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 5, sig5, text_color=color.black, bgcolor=f_sig_bg(sig5, c5 > ema20_5 and ema20_5 > ema50_5, c5 < ema20_5 and ema20_5 < ema50_5), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 6, "ITUB", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 6, "$" + str.tostring(c6, "#.##") + " (" + str.tostring(chg6, "#.##") + "%)", text_color=chg6 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 6, dvol6 > 1e6 ? "$" + str.tostring(dvol6/1e6, "#.#") + "M" : "$" + str.tostring(dvol6/1e3, "#.#") + "K", text_color=dvol6 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 6, "R:" + str.tostring(rsi6, "#.#") + " V:" + str.tostring(rvol6, "#.#") + "x", text_color=rsi6 < 30 ? color.lime : rsi6 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 6, sig6, text_color=color.black, bgcolor=f_sig_bg(sig6, c6 > ema20_6 and ema20_6 > ema50_6, c6 < ema20_6 and ema20_6 < ema50_6), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 7, "BBD", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 7, "$" + str.tostring(c7, "#.##") + " (" + str.tostring(chg7, "#.##") + "%)", text_color=chg7 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 7, dvol7 > 1e6 ? "$" + str.tostring(dvol7/1e6, "#.#") + "M" : "$" + str.tostring(dvol7/1e3, "#.#") + "K", text_color=dvol7 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 7, "R:" + str.tostring(rsi7, "#.#") + " V:" + str.tostring(rvol7, "#.#") + "x", text_color=rsi7 < 30 ? color.lime : rsi7 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 7, sig7, text_color=color.black, bgcolor=f_sig_bg(sig7, c7 > ema20_7 and ema20_7 > ema50_7, c7 < ema20_7 and ema20_7 < ema50_7), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 8, "ERIC", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 8, "$" + str.tostring(c8, "#.##") + " (" + str.tostring(chg8, "#.##") + "%)", text_color=chg8 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 8, dvol8 > 1e6 ? "$" + str.tostring(dvol8/1e6, "#.#") + "M" : "$" + str.tostring(dvol8/1e3, "#.#") + "K", text_color=dvol8 > 5e6 ? color.lime : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 8, "R:" + str.tostring(rsi8, "#.#") + " V:" + str.tostring(rvol8, "#.#") + "x", text_color=rsi8 < 30 ? color.lime : rsi8 > 70 ? color.red : color.white, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 8, sig8, text_color=color.black, bgcolor=f_sig_bg(sig8, c8 > ema20_8 and ema20_8 > ema50_8, c8 < ema20_8 and ema20_8 < ema50_8), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 9, "F", text_color=color.yellow, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 9, "$" + str.tostring(c9, "#.##") + " (" + str.tostring(chg9, "#.##") + "%)", text_color=chg9 > 0 ? color.lime : color.red, bgcolor=#0d1117, text_size=size.small, text_halign=text.align_center)
