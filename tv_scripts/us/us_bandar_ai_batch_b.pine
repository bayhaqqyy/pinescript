// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// Generated on 2026-05-15 | Strategy: US BANDAR V3
//@version=6
indicator("US BANDAR V3 - BATCH B (6 Tickers)", overlay=true, max_bars_back=200)


// ============================================================================
// INPUTS
// ============================================================================
tf = input.timeframe("10", "Timeframe Screener")
min_tv = input.float(1000000, "Min Volume ($)")

srLen = input.int(14, "Support/Resistance Lookback", minval=5, maxval=200)
atrLen = input.int(14, "ATR Length", minval=5, maxval=100)
leverage = input.int(1, "Leverage", minval=1, maxval=125)

entryScore = input.int(65, "Entry Score")
scoreGap = input.int(6, "Score Gap")

slAtrMult = input.float(1.4, "SL ATR Mult", step=0.1)
tpAtrMult = input.float(2.4, "TP ATR Mult (Unused)", step=0.1)
rr1 = input.float(2.0, "Risk Reward 1 (TP1)", minval=0.5, step=0.1)
rr2 = input.float(3.5, "Risk Reward 2 (TP2)", minval=0.5, step=0.1)

minSlRawPct = input.float(0.6, "Minimum SL Raw %", step=0.1)
minTpRawPct = input.float(1.0, "Minimum TP Raw %", step=0.1)
maxPlanRiskPct = input.float(2.0, "Max Raw Risk % For Action", step=0.5)
maxLevRiskPct = input.float(25.0, "Max Leveraged Risk % For Action", step=5.0)

breakoutBufferPct = input.float(0.04, "Breakout Buffer %", step=0.01)
srAtrBuffer = input.float(0.15, "S/R ATR Buffer", step=0.05)
useStructureSL = input.bool(true, "Use Structure SL When Reasonable")
maxStructureRiskPct = input.float(2.5, "Max Structure SL %", step=0.5)

cooldownBars = input.int(3, "Alert Cooldown Bars", minval=1)
useReversalEntry = input.bool(false, "Use Reversal As Entry")
sameBarRule = input.string("SL_FIRST", "Same Bar TP/SL Rule", options=["SL_FIRST", "TP_FIRST", "IGNORE"])
pos = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// ============================================================================
// COLORS & HELPERS
// ============================================================================
cHeader = color.rgb(55, 62, 70)
cDark = color.rgb(28, 33, 40)
cText = color.white
cGreen = color.rgb(0, 180, 90)
cLime = color.rgb(70, 220, 90)
cBlue = color.rgb(40, 130, 220)
cYellow = color.rgb(220, 190, 40)
cOrange = color.rgb(230, 120, 40)
cRed = color.rgb(220, 60, 60)
cGray = color.rgb(110, 110, 110)

f_status_color(s) =>
    s == "FLYING" ? cLime :
      s == "RUNNING" ? cGreen :
      s == "SETUP" ? cBlue :
      s == "TP1-HIT" ? cLime :
      s == "TP2-HIT" ? cLime :
      s == "SL-BROKE" ? cRed :
      cGray

f_zona_color(z) =>
    z == "MURAH" ? cBlue :
      z == "MID" ? cYellow :
      cRed

f_macd_color(m) =>
    m == "UP" ? cGreen :
      m == "DOWN" ? cRed :
      cYellow

f_signal_color(sig) =>
    sig == "BREAKOUT BUY" ? cLime :
      sig == "BULL ABSORB" ? cGreen :
      sig == "SNIPER BUY" ? cLime :
      cGray

f_score_color(score) =>
    score >= 85 ? color.lime :
      score >= 70 ? color.green :
      score >= 55 ? color.yellow :
      score >= 40 ? color.orange :
      color.red

f_cell(tbl, col, row, txt, bg, txtColor) =>
    table.cell(tbl, col, row, txt, bgcolor=bg, text_color=txtColor, text_size=size.small)

f_header(tbl, col, title) =>
    table.cell(tbl, col, 0, title, bgcolor=cHeader, text_color=color.yellow, text_size=size.small)

f_value_idr(v) =>
    v >= 1000000000 ? "$" + str.tostring(v / 1000000000, "#.##") + "B" :
      v >= 1000000 ? "$" + str.tostring(v / 1000000, "#.##") + "M" :
      "$" + str.tostring(v, "#.##")

// ============================================================================
// CORE ENGINE FUNCTION (DASHBOARD)
// ============================================================================
f_round_tick(x) => math.round(x / syminfo.mintick) * syminfo.mintick

f_dashboard_engine(strategy_mode) =>
    support = ta.lowest(low[1], srLen)
    resistance = ta.highest(high[1], srLen)
    
    atrVal = ta.atr(atrLen)
    rsiVal = ta.rsi(close, 14)
    [macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
    
    volMA = ta.sma(volume, 20)
    rvol = volMA > 0 ? volume / volMA : 0.0
    rvolPct = rvol * 100
    
    ema20 = ta.ema(close, 20)
    ema50 = ta.ema(close, 50)
    ema200 = ta.ema(close, 200)
    
    body = math.abs(close - open)
    candleRange = math.max(high - low, syminfo.mintick)
    upperWick = high - math.max(open, close)
    lowerWick = math.min(open, close) - low
    
    closeNearHigh = candleRange > 0 and close >= low + candleRange * 0.65
    closeNearLow  = candleRange > 0 and close <= low + candleRange * 0.35
    
    // US SWING LOGIC
    bullTrend = close > ema200 and ema20 > ema50
    volSpike = rvol > 1.5
    highest20 = ta.highest(high, 20)
    swingBreakout = close > highest20[1] and volSpike
    bullAbsorb = lowerWick > body * 1.5 and volSpike and close > open
    
    swingSignal = swingBreakout and bullTrend ? "BREAKOUT BUY" : bullAbsorb and bullTrend ? "BULL ABSORB" : "WAIT"
    
    // US BANDAR LOGIC
    sniperBuy = (close > ema200) and volSpike and (close > open)
    bBullAbsorb = lowerWick > body * 1.1 and rvol > 1.3 and close > low + (candleRange * 0.4)
    bandarSignal = sniperBuy ? "SNIPER BUY" : bBullAbsorb ? "BULL ABSORB" : "WAIT"
    
    signal = strategy_mode == "SWING" ? swingSignal : bandarSignal
    validBuySetup = signal != "WAIT"
    
    // Entry price
    entryPrice = not na(support) and support > 0 ? support : close
    
    // SL: Stop Loss calculation
    baseSlDist = math.max(atrVal * slAtrMult, entryPrice * minSlRawPct / 100.0, syminfo.mintick)
    structSl = support - atrVal * srAtrBuffer
    structSlDist = entryPrice - structSl
    structRiskPct = entryPrice > 0 ? (structSlDist / entryPrice * 100.0) : na
    useStruct = useStructureSL and not na(structSlDist) and structSlDist > 0 and structRiskPct <= maxStructureRiskPct
    slDist = useStruct ? math.max(baseSlDist, structSlDist) : baseSlDist
    sl = entryPrice - slDist
    
    // TP: Dual take profit levels
    risk = math.max(entryPrice - sl, syminfo.mintick)
    tp1 = entryPrice + risk * rr1
    tp2 = entryPrice + risk * rr2
    
    entryPrice := f_round_tick(entryPrice)
    tp1 := f_round_tick(tp1)
    tp2 := f_round_tick(tp2)
    sl := f_round_tick(sl)
    
    // Risk checks
    riskOk = entryPrice > 0 and (slDist / entryPrice * 100.0) <= maxPlanRiskPct and (slDist / entryPrice * 100.0 * leverage) <= maxLevRiskPct
    validBuy = validBuySetup and riskOk
    
    valueBar = close * volume
    
    rangeSr = math.max(resistance - support, syminfo.mintick)
    rangePos = (close - support) / rangeSr
    zona = rangePos <= 0.382 ? "MURAH" : rangePos <= 0.618 ? "MID" : "MAHAL"
    
    trendScore = (close > ema20 ? 10 : 0) + (close > ema50 ? 10 : 0) + (close > ema200 ? 10 : 0)
    zoneScore = zona == "MURAH" ? 20 : zona == "MID" ? 12 : 3
    macdBull = macdLine > macdSignal and macdHist > 0
    rsiHealthy = rsiVal >= 35 and rsiVal <= 65
    rsiHot = rsiVal > 65 and rsiVal <= 75
    momentumScore = (rsiHealthy ? 8 : rsiHot ? 5 : 0) + (macdBull ? 7 : 0) + (validBuy ? 10 : 0)
    volumeScore = rvol >= 2.0 ? 15 : rvol >= 1.3 ? 10 : rvol >= 0.8 ? 5 : 0
    
    bigAccum = lowerWick > body * 1.2 and rvol >= 2.0 and close >= open and close > low + candleRange * 0.5
    accum = rvol >= 1.3 and close > open and close > ema20
    distAwal = upperWick > body * 1.2 and rvol >= 1.5 and close < open
    sepi = rvol < 0.7
    
    bandarState = bigAccum ? "BIG ACCUM" : accum ? "ACCUM" : distAwal ? "DIST AWAL" : sepi ? "SEPI" : "NORMAL"
    
    flowScore = bigAccum ? 20 : accum ? 14 : distAwal ? 0 : sepi ? 2 : 8
    scoreRaw = trendScore + zoneScore + momentumScore + volumeScore + flowScore
    score = math.min(100, scoreRaw)
    
    tpHit = high >= tp1
    slBroken = low <= sl
    
    statusFlag = slBroken ? 1.0 : tpHit ? 2.0 : validBuy ? 3.0 : score >= 60 ? 4.0 : close > ema20 ? 5.0 : 0.0
    zonaFlag = zona == "MURAH" ? 1.0 : zona == "MID" ? 2.0 : 3.0
    macdFlag = macdLine > macdSignal ? 1.0 : 0.0
    bandarFlag = bigAccum ? 1.0 : accum ? 2.0 : distAwal ? 3.0 : sepi ? 4.0 : 0.0
    actionFlag = distAwal ? 1.0 : validBuy ? 2.0 : 0.0
    signalFlag = signal == "BREAKOUT BUY" ? 1.0 : signal == "BULL ABSORB" ? 2.0 : signal == "SNIPER BUY" ? 3.0 : 0.0
    
    // Pack 5 flags into a single float to reduce request.security tuple elements (19 -> 14)
    packedFlags = signalFlag + actionFlag * 10.0 + bandarFlag * 100.0 + macdFlag * 1000.0 + statusFlag * 10000.0
    
    [close, high, low, support, resistance, entryPrice, tp1, tp2, sl, rsiVal, rvolPct, valueBar, score, packedFlags]


// ============================================================================
// TICKER DEFINITIONS
// ============================================================================
tk1 = "NASDAQ:AAPL"  // ~$198.00
tk2 = "NASDAQ:GOOGL"  // ~$175.00
tk3 = "NASDAQ:MSFT"  // ~$455.00
tk4 = "NASDAQ:NFLX"  // ~$1100.00
tk5 = "NASDAQ:SOFI"  // ~$15.76
tk6 = "NYSE:NIO"  // ~$6.28

// ============================================================================
// DATA FETCH - request.security
// ============================================================================
// --- Ticker 1 State Machine and Fetch ---
var string activeSide1 = ""
var float activeEntry1 = na
var float activeTp1_1 = na
var float activeTp2_1 = na
var float activeSl1 = na
var string lastEvent1 = ""
var int lastBar1 = na
var float activeMode1 = na

[now1, hi1, lo1, sup1, rst1, entry1, tp1_1, tp2_1, sl_1, rsi1, rvolPct1, valueBar1, score1, packedFlags1] = request.security(tk1, tf, f_dashboard_engine("BANDAR"))

// Unpack flags
signalFlag1 = math.floor(packedFlags1 % 10)
actionFlag1 = math.floor((packedFlags1 / 10) % 10)
bandarFlag1 = math.floor((packedFlags1 / 100) % 10)
macdFlag1   = math.floor((packedFlags1 / 1000) % 10)
statusFlag1 = math.floor((packedFlags1 / 10000) % 10)

// Decode flags locally
statusRaw1 = statusFlag1 == 1.0 ? "SL-BROKE" : statusFlag1 == 2.0 ? "TP-HIT" : statusFlag1 == 3.0 ? "FLYING" : statusFlag1 == 4.0 ? "SETUP" : statusFlag1 == 5.0 ? "RUNNING" : "WAIT"
macd1 = macdFlag1 == 1.0 ? "UP" : "DOWN"
bandar1 = bandarFlag1 == 1.0 ? "BIG ACCUM" : bandarFlag1 == 2.0 ? "ACCUM" : bandarFlag1 == 3.0 ? "DIST AWAL" : bandarFlag1 == 4.0 ? "SEPI" : "NORMAL"
action1 = actionFlag1 == 1.0 ? "WASPADA" : actionFlag1 == 2.0 ? "BUY" : "WAIT"
signal1 = signalFlag1 == 1.0 ? "BREAKOUT BUY" : signalFlag1 == 2.0 ? "BULL ABSORB" : signalFlag1 == 3.0 ? "SNIPER BUY" : "WAIT"

// Calculate zona locally on-chart to save memory
rangeSr1 = math.max(rst1 - sup1, syminfo.mintick)
rangePos1 = (now1 - sup1) / rangeSr1
zona1 = rangePos1 <= 0.382 ? "MURAH" : rangePos1 <= 0.618 ? "MID" : "MAHAL"

// State Machine logic
longTpHit1 = activeSide1 == "BUY" and hi1 >= activeTp1_1
longTp2Hit1 = activeSide1 == "BUY" and hi1 >= activeTp2_1
longSlHit1 = activeSide1 == "BUY" and lo1 <= activeSl1

bothHitLong1 = longTpHit1 and longSlHit1
if bothHitLong1
    if sameBarRule == "SL_FIRST"
        longTpHit1 := false
        longTp2Hit1 := false
    else if sameBarRule == "TP_FIRST"
        longSlHit1 := false
    else if sameBarRule == "IGNORE"
        longTpHit1 := false
        longTp2Hit1 := false
        longSlHit1 := false

entryEvent1 = activeSide1 == "" and action1 == "BUY" ? "BUY_ENTRY" : "NONE"
event1 = (activeSide1 == "BUY" and longSlHit1) ? "SL_HIT" : (activeSide1 == "BUY" and longTp2Hit1) ? "TP2_HIT" : (activeSide1 == "BUY" and longTpHit1) ? "TP1_HIT" : entryEvent1

alertSide1 = event1 == "BUY_ENTRY" ? "BUY" : activeSide1
alertEntry1 = event1 == "BUY_ENTRY" ? entry1 : activeEntry1
alertTp1_1 = event1 == "BUY_ENTRY" ? tp1_1 : activeTp1_1
alertTp2_1 = event1 == "BUY_ENTRY" ? tp2_1 : activeTp2_1
alertSl1 = event1 == "BUY_ENTRY" ? sl_1 : activeSl1

if event1 == "SL_HIT" or event1 == "TP1_HIT" or event1 == "TP2_HIT"
    activeSide1 := ""
    activeEntry1 := na
    activeTp1_1 := na
    activeTp2_1 := na
    activeSl1 := na
    activeMode1 := na
else if event1 == "BUY_ENTRY"
    activeSide1 := "BUY"
    activeEntry1 := entry1
    activeTp1_1 := tp1_1
    activeTp2_1 := tp2_1
    activeSl1 := sl_1
    activeMode1 := signalFlag1

sendAlert1 = event1 == "BUY_ENTRY" or event1 == "TP1_HIT" or event1 == "TP2_HIT" or event1 == "SL_HIT"
canAlert1 = sendAlert1 and (event1 != lastEvent1 or na(lastBar1) or bar_index - lastBar1 >= cooldownBars)

alertModeRaw1 = event1 == "BUY_ENTRY" ? signalFlag1 : activeMode1
alertMode1 = alertModeRaw1 == 1.0 ? "BREAKOUT_BUY" : alertModeRaw1 == 2.0 ? "BULL_ABSORB" : alertModeRaw1 == 3.0 ? "SNIPER_BUY" : "NONE"

// Display values - locked if position is active, else dynamic
entryDisp1 = na(activeEntry1) ? entry1 : activeEntry1
tp1Disp1 = na(activeTp1_1) ? tp1_1 : activeTp1_1
tp2Disp1 = na(activeTp2_1) ? tp2_1 : activeTp2_1
slDisp1 = na(activeSl1) ? sl_1 : activeSl1

pctTp1_1 = entryDisp1 > 0 ? ((tp1Disp1 - entryDisp1) / entryDisp1) * 100.0 : na
pctTp2_1 = entryDisp1 > 0 ? ((tp2Disp1 - entryDisp1) / entryDisp1) * 100.0 : na
pnlPct1 = activeSide1 == "BUY" ? ((now1 - activeEntry1) / activeEntry1) * 100.0 : na

// Override status for active trades
status1 = activeSide1 == "BUY" ? "RUNNING" : (event1 == "TP1_HIT" or event1 == "TP2_HIT") ? "TP-HIT" : event1 == "SL_HIT" ? "SL-BROKE" : statusRaw1

// --- Ticker 2 State Machine and Fetch ---
var string activeSide2 = ""
var float activeEntry2 = na
var float activeTp1_2 = na
var float activeTp2_2 = na
var float activeSl2 = na
var string lastEvent2 = ""
var int lastBar2 = na
var float activeMode2 = na

[now2, hi2, lo2, sup2, rst2, entry2, tp1_2, tp2_2, sl_2, rsi2, rvolPct2, valueBar2, score2, packedFlags2] = request.security(tk2, tf, f_dashboard_engine("BANDAR"))

// Unpack flags
signalFlag2 = math.floor(packedFlags2 % 10)
actionFlag2 = math.floor((packedFlags2 / 10) % 10)
bandarFlag2 = math.floor((packedFlags2 / 100) % 10)
macdFlag2   = math.floor((packedFlags2 / 1000) % 10)
statusFlag2 = math.floor((packedFlags2 / 10000) % 10)

// Decode flags locally
statusRaw2 = statusFlag2 == 1.0 ? "SL-BROKE" : statusFlag2 == 2.0 ? "TP-HIT" : statusFlag2 == 3.0 ? "FLYING" : statusFlag2 == 4.0 ? "SETUP" : statusFlag2 == 5.0 ? "RUNNING" : "WAIT"
macd2 = macdFlag2 == 1.0 ? "UP" : "DOWN"
bandar2 = bandarFlag2 == 1.0 ? "BIG ACCUM" : bandarFlag2 == 2.0 ? "ACCUM" : bandarFlag2 == 3.0 ? "DIST AWAL" : bandarFlag2 == 4.0 ? "SEPI" : "NORMAL"
action2 = actionFlag2 == 1.0 ? "WASPADA" : actionFlag2 == 2.0 ? "BUY" : "WAIT"
signal2 = signalFlag2 == 1.0 ? "BREAKOUT BUY" : signalFlag2 == 2.0 ? "BULL ABSORB" : signalFlag2 == 3.0 ? "SNIPER BUY" : "WAIT"

// Calculate zona locally on-chart to save memory
rangeSr2 = math.max(rst2 - sup2, syminfo.mintick)
rangePos2 = (now2 - sup2) / rangeSr2
zona2 = rangePos2 <= 0.382 ? "MURAH" : rangePos2 <= 0.618 ? "MID" : "MAHAL"

// State Machine logic
longTpHit2 = activeSide2 == "BUY" and hi2 >= activeTp1_2
longTp2Hit2 = activeSide2 == "BUY" and hi2 >= activeTp2_2
longSlHit2 = activeSide2 == "BUY" and lo2 <= activeSl2

bothHitLong2 = longTpHit2 and longSlHit2
if bothHitLong2
    if sameBarRule == "SL_FIRST"
        longTpHit2 := false
        longTp2Hit2 := false
    else if sameBarRule == "TP_FIRST"
        longSlHit2 := false
    else if sameBarRule == "IGNORE"
        longTpHit2 := false
        longTp2Hit2 := false
        longSlHit2 := false

entryEvent2 = activeSide2 == "" and action2 == "BUY" ? "BUY_ENTRY" : "NONE"
event2 = (activeSide2 == "BUY" and longSlHit2) ? "SL_HIT" : (activeSide2 == "BUY" and longTp2Hit2) ? "TP2_HIT" : (activeSide2 == "BUY" and longTpHit2) ? "TP1_HIT" : entryEvent2

alertSide2 = event2 == "BUY_ENTRY" ? "BUY" : activeSide2
alertEntry2 = event2 == "BUY_ENTRY" ? entry2 : activeEntry2
alertTp1_2 = event2 == "BUY_ENTRY" ? tp1_2 : activeTp1_2
alertTp2_2 = event2 == "BUY_ENTRY" ? tp2_2 : activeTp2_2
alertSl2 = event2 == "BUY_ENTRY" ? sl_2 : activeSl2

if event2 == "SL_HIT" or event2 == "TP1_HIT" or event2 == "TP2_HIT"
    activeSide2 := ""
    activeEntry2 := na
    activeTp1_2 := na
    activeTp2_2 := na
    activeSl2 := na
    activeMode2 := na
else if event2 == "BUY_ENTRY"
    activeSide2 := "BUY"
    activeEntry2 := entry2
    activeTp1_2 := tp1_2
    activeTp2_2 := tp2_2
    activeSl2 := sl_2
    activeMode2 := signalFlag2

sendAlert2 = event2 == "BUY_ENTRY" or event2 == "TP1_HIT" or event2 == "TP2_HIT" or event2 == "SL_HIT"
canAlert2 = sendAlert2 and (event2 != lastEvent2 or na(lastBar2) or bar_index - lastBar2 >= cooldownBars)

alertModeRaw2 = event2 == "BUY_ENTRY" ? signalFlag2 : activeMode2
alertMode2 = alertModeRaw2 == 1.0 ? "BREAKOUT_BUY" : alertModeRaw2 == 2.0 ? "BULL_ABSORB" : alertModeRaw2 == 3.0 ? "SNIPER_BUY" : "NONE"

// Display values - locked if position is active, else dynamic
entryDisp2 = na(activeEntry2) ? entry2 : activeEntry2
tp1Disp2 = na(activeTp1_2) ? tp1_2 : activeTp1_2
tp2Disp2 = na(activeTp2_2) ? tp2_2 : activeTp2_2
slDisp2 = na(activeSl2) ? sl_2 : activeSl2

pctTp1_2 = entryDisp2 > 0 ? ((tp1Disp2 - entryDisp2) / entryDisp2) * 100.0 : na
pctTp2_2 = entryDisp2 > 0 ? ((tp2Disp2 - entryDisp2) / entryDisp2) * 100.0 : na
pnlPct2 = activeSide2 == "BUY" ? ((now2 - activeEntry2) / activeEntry2) * 100.0 : na

// Override status for active trades
status2 = activeSide2 == "BUY" ? "RUNNING" : (event2 == "TP1_HIT" or event2 == "TP2_HIT") ? "TP-HIT" : event2 == "SL_HIT" ? "SL-BROKE" : statusRaw2

// --- Ticker 3 State Machine and Fetch ---
var string activeSide3 = ""
var float activeEntry3 = na
var float activeTp1_3 = na
var float activeTp2_3 = na
var float activeSl3 = na
var string lastEvent3 = ""
var int lastBar3 = na
var float activeMode3 = na

[now3, hi3, lo3, sup3, rst3, entry3, tp1_3, tp2_3, sl_3, rsi3, rvolPct3, valueBar3, score3, packedFlags3] = request.security(tk3, tf, f_dashboard_engine("BANDAR"))

// Unpack flags
signalFlag3 = math.floor(packedFlags3 % 10)
actionFlag3 = math.floor((packedFlags3 / 10) % 10)
bandarFlag3 = math.floor((packedFlags3 / 100) % 10)
macdFlag3   = math.floor((packedFlags3 / 1000) % 10)
statusFlag3 = math.floor((packedFlags3 / 10000) % 10)

// Decode flags locally
statusRaw3 = statusFlag3 == 1.0 ? "SL-BROKE" : statusFlag3 == 2.0 ? "TP-HIT" : statusFlag3 == 3.0 ? "FLYING" : statusFlag3 == 4.0 ? "SETUP" : statusFlag3 == 5.0 ? "RUNNING" : "WAIT"
macd3 = macdFlag3 == 1.0 ? "UP" : "DOWN"
bandar3 = bandarFlag3 == 1.0 ? "BIG ACCUM" : bandarFlag3 == 2.0 ? "ACCUM" : bandarFlag3 == 3.0 ? "DIST AWAL" : bandarFlag3 == 4.0 ? "SEPI" : "NORMAL"
action3 = actionFlag3 == 1.0 ? "WASPADA" : actionFlag3 == 2.0 ? "BUY" : "WAIT"
signal3 = signalFlag3 == 1.0 ? "BREAKOUT BUY" : signalFlag3 == 2.0 ? "BULL ABSORB" : signalFlag3 == 3.0 ? "SNIPER BUY" : "WAIT"

// Calculate zona locally on-chart to save memory
rangeSr3 = math.max(rst3 - sup3, syminfo.mintick)
rangePos3 = (now3 - sup3) / rangeSr3
zona3 = rangePos3 <= 0.382 ? "MURAH" : rangePos3 <= 0.618 ? "MID" : "MAHAL"

// State Machine logic
longTpHit3 = activeSide3 == "BUY" and hi3 >= activeTp1_3
longTp2Hit3 = activeSide3 == "BUY" and hi3 >= activeTp2_3
longSlHit3 = activeSide3 == "BUY" and lo3 <= activeSl3

bothHitLong3 = longTpHit3 and longSlHit3
if bothHitLong3
    if sameBarRule == "SL_FIRST"
        longTpHit3 := false
        longTp2Hit3 := false
    else if sameBarRule == "TP_FIRST"
        longSlHit3 := false
    else if sameBarRule == "IGNORE"
        longTpHit3 := false
        longTp2Hit3 := false
        longSlHit3 := false

entryEvent3 = activeSide3 == "" and action3 == "BUY" ? "BUY_ENTRY" : "NONE"
event3 = (activeSide3 == "BUY" and longSlHit3) ? "SL_HIT" : (activeSide3 == "BUY" and longTp2Hit3) ? "TP2_HIT" : (activeSide3 == "BUY" and longTpHit3) ? "TP1_HIT" : entryEvent3

alertSide3 = event3 == "BUY_ENTRY" ? "BUY" : activeSide3
alertEntry3 = event3 == "BUY_ENTRY" ? entry3 : activeEntry3
alertTp1_3 = event3 == "BUY_ENTRY" ? tp1_3 : activeTp1_3
alertTp2_3 = event3 == "BUY_ENTRY" ? tp2_3 : activeTp2_3
alertSl3 = event3 == "BUY_ENTRY" ? sl_3 : activeSl3

if event3 == "SL_HIT" or event3 == "TP1_HIT" or event3 == "TP2_HIT"
    activeSide3 := ""
    activeEntry3 := na
    activeTp1_3 := na
    activeTp2_3 := na
    activeSl3 := na
    activeMode3 := na
else if event3 == "BUY_ENTRY"
    activeSide3 := "BUY"
    activeEntry3 := entry3
    activeTp1_3 := tp1_3
    activeTp2_3 := tp2_3
    activeSl3 := sl_3
    activeMode3 := signalFlag3

sendAlert3 = event3 == "BUY_ENTRY" or event3 == "TP1_HIT" or event3 == "TP2_HIT" or event3 == "SL_HIT"
canAlert3 = sendAlert3 and (event3 != lastEvent3 or na(lastBar3) or bar_index - lastBar3 >= cooldownBars)

alertModeRaw3 = event3 == "BUY_ENTRY" ? signalFlag3 : activeMode3
alertMode3 = alertModeRaw3 == 1.0 ? "BREAKOUT_BUY" : alertModeRaw3 == 2.0 ? "BULL_ABSORB" : alertModeRaw3 == 3.0 ? "SNIPER_BUY" : "NONE"

// Display values - locked if position is active, else dynamic
entryDisp3 = na(activeEntry3) ? entry3 : activeEntry3
tp1Disp3 = na(activeTp1_3) ? tp1_3 : activeTp1_3
tp2Disp3 = na(activeTp2_3) ? tp2_3 : activeTp2_3
slDisp3 = na(activeSl3) ? sl_3 : activeSl3

pctTp1_3 = entryDisp3 > 0 ? ((tp1Disp3 - entryDisp3) / entryDisp3) * 100.0 : na
pctTp2_3 = entryDisp3 > 0 ? ((tp2Disp3 - entryDisp3) / entryDisp3) * 100.0 : na
pnlPct3 = activeSide3 == "BUY" ? ((now3 - activeEntry3) / activeEntry3) * 100.0 : na

// Override status for active trades
status3 = activeSide3 == "BUY" ? "RUNNING" : (event3 == "TP1_HIT" or event3 == "TP2_HIT") ? "TP-HIT" : event3 == "SL_HIT" ? "SL-BROKE" : statusRaw3

// --- Ticker 4 State Machine and Fetch ---
var string activeSide4 = ""
var float activeEntry4 = na
var float activeTp1_4 = na
var float activeTp2_4 = na
var float activeSl4 = na
var string lastEvent4 = ""
var int lastBar4 = na
var float activeMode4 = na

[now4, hi4, lo4, sup4, rst4, entry4, tp1_4, tp2_4, sl_4, rsi4, rvolPct4, valueBar4, score4, packedFlags4] = request.security(tk4, tf, f_dashboard_engine("BANDAR"))

// Unpack flags
signalFlag4 = math.floor(packedFlags4 % 10)
actionFlag4 = math.floor((packedFlags4 / 10) % 10)
bandarFlag4 = math.floor((packedFlags4 / 100) % 10)
macdFlag4   = math.floor((packedFlags4 / 1000) % 10)
statusFlag4 = math.floor((packedFlags4 / 10000) % 10)

// Decode flags locally
statusRaw4 = statusFlag4 == 1.0 ? "SL-BROKE" : statusFlag4 == 2.0 ? "TP-HIT" : statusFlag4 == 3.0 ? "FLYING" : statusFlag4 == 4.0 ? "SETUP" : statusFlag4 == 5.0 ? "RUNNING" : "WAIT"
macd4 = macdFlag4 == 1.0 ? "UP" : "DOWN"
bandar4 = bandarFlag4 == 1.0 ? "BIG ACCUM" : bandarFlag4 == 2.0 ? "ACCUM" : bandarFlag4 == 3.0 ? "DIST AWAL" : bandarFlag4 == 4.0 ? "SEPI" : "NORMAL"
action4 = actionFlag4 == 1.0 ? "WASPADA" : actionFlag4 == 2.0 ? "BUY" : "WAIT"
signal4 = signalFlag4 == 1.0 ? "BREAKOUT BUY" : signalFlag4 == 2.0 ? "BULL ABSORB" : signalFlag4 == 3.0 ? "SNIPER BUY" : "WAIT"

// Calculate zona locally on-chart to save memory
rangeSr4 = math.max(rst4 - sup4, syminfo.mintick)
rangePos4 = (now4 - sup4) / rangeSr4
zona4 = rangePos4 <= 0.382 ? "MURAH" : rangePos4 <= 0.618 ? "MID" : "MAHAL"

// State Machine logic
longTpHit4 = activeSide4 == "BUY" and hi4 >= activeTp1_4
longTp2Hit4 = activeSide4 == "BUY" and hi4 >= activeTp2_4
longSlHit4 = activeSide4 == "BUY" and lo4 <= activeSl4

bothHitLong4 = longTpHit4 and longSlHit4
if bothHitLong4
    if sameBarRule == "SL_FIRST"
        longTpHit4 := false
        longTp2Hit4 := false
    else if sameBarRule == "TP_FIRST"
        longSlHit4 := false
    else if sameBarRule == "IGNORE"
        longTpHit4 := false
        longTp2Hit4 := false
        longSlHit4 := false

entryEvent4 = activeSide4 == "" and action4 == "BUY" ? "BUY_ENTRY" : "NONE"
event4 = (activeSide4 == "BUY" and longSlHit4) ? "SL_HIT" : (activeSide4 == "BUY" and longTp2Hit4) ? "TP2_HIT" : (activeSide4 == "BUY" and longTpHit4) ? "TP1_HIT" : entryEvent4

alertSide4 = event4 == "BUY_ENTRY" ? "BUY" : activeSide4
alertEntry4 = event4 == "BUY_ENTRY" ? entry4 : activeEntry4
alertTp1_4 = event4 == "BUY_ENTRY" ? tp1_4 : activeTp1_4
alertTp2_4 = event4 == "BUY_ENTRY" ? tp2_4 : activeTp2_4
alertSl4 = event4 == "BUY_ENTRY" ? sl_4 : activeSl4

if event4 == "SL_HIT" or event4 == "TP1_HIT" or event4 == "TP2_HIT"
    activeSide4 := ""
    activeEntry4 := na
    activeTp1_4 := na
    activeTp2_4 := na
    activeSl4 := na
    activeMode4 := na
else if event4 == "BUY_ENTRY"
    activeSide4 := "BUY"
    activeEntry4 := entry4
    activeTp1_4 := tp1_4
    activeTp2_4 := tp2_4
    activeSl4 := sl_4
    activeMode4 := signalFlag4

sendAlert4 = event4 == "BUY_ENTRY" or event4 == "TP1_HIT" or event4 == "TP2_HIT" or event4 == "SL_HIT"
canAlert4 = sendAlert4 and (event4 != lastEvent4 or na(lastBar4) or bar_index - lastBar4 >= cooldownBars)

alertModeRaw4 = event4 == "BUY_ENTRY" ? signalFlag4 : activeMode4
alertMode4 = alertModeRaw4 == 1.0 ? "BREAKOUT_BUY" : alertModeRaw4 == 2.0 ? "BULL_ABSORB" : alertModeRaw4 == 3.0 ? "SNIPER_BUY" : "NONE"

// Display values - locked if position is active, else dynamic
entryDisp4 = na(activeEntry4) ? entry4 : activeEntry4
tp1Disp4 = na(activeTp1_4) ? tp1_4 : activeTp1_4
tp2Disp4 = na(activeTp2_4) ? tp2_4 : activeTp2_4
slDisp4 = na(activeSl4) ? sl_4 : activeSl4

pctTp1_4 = entryDisp4 > 0 ? ((tp1Disp4 - entryDisp4) / entryDisp4) * 100.0 : na
pctTp2_4 = entryDisp4 > 0 ? ((tp2Disp4 - entryDisp4) / entryDisp4) * 100.0 : na
pnlPct4 = activeSide4 == "BUY" ? ((now4 - activeEntry4) / activeEntry4) * 100.0 : na

// Override status for active trades
status4 = activeSide4 == "BUY" ? "RUNNING" : (event4 == "TP1_HIT" or event4 == "TP2_HIT") ? "TP-HIT" : event4 == "SL_HIT" ? "SL-BROKE" : statusRaw4

