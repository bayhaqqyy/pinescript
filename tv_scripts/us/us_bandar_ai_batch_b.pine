// ============================================================================
// TABLE DISPLAY
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left
var tbl = table.new(tbl_pos, 22, 7, border_width=1, border_color=#333333)

if barstate.islast
    f_header(tbl, 0, "TICKER")
    f_header(tbl, 1, "TF")
    f_header(tbl, 2, "SUP")
    f_header(tbl, 3, "RST")
    f_header(tbl, 4, "ENTRY")
    f_header(tbl, 5, "NOW")
    f_header(tbl, 6, "TP1")
    f_header(tbl, 7, "TP2")
    f_header(tbl, 8, "SL")
    f_header(tbl, 9, "PnL%")
    f_header(tbl, 10, "%TP1")
    f_header(tbl, 11, "%TP2")
    f_header(tbl, 12, "STATUS")
    f_header(tbl, 13, "ZONA")
    f_header(tbl, 14, "RSI")
    f_header(tbl, 15, "MACD")
    f_header(tbl, 16, "RVOL")
    f_header(tbl, 17, "VALUE")
    f_header(tbl, 18, "FLOW")
    f_header(tbl, 19, "ACTION")
    f_header(tbl, 20, "SCORE")
    f_header(tbl, 21, "SINYAL")
    // Row 1
    pnlDisp1 = na(pnlPct1) ? "-" : (pnlPct1 >= 0.0 ? "+" : "") + str.tostring(pnlPct1, "#.##") + "%"
    pnlBg1 = na(pnlPct1) ? cDark : (pnlPct1 >= 0.0 ? cGreen : cRed)
    entryValDisp1 = na(entryDisp1) ? "-" : str.tostring(entryDisp1, "#.00")
    tp1ValDisp1 = na(tp1Disp1) ? "-" : str.tostring(tp1Disp1, "#.00")
    tp2ValDisp1 = na(tp2Disp1) ? "-" : str.tostring(tp2Disp1, "#.00")
    slValDisp1 = na(slDisp1) ? "-" : str.tostring(slDisp1, "#.00")
    
    f_cell(tbl, 0, 1, "AAPL", color.rgb(30, 90, 180), color.white)
    f_cell(tbl, 1, 1, tf, cDark, color.white)
    f_cell(tbl, 2, 1, str.tostring(sup1, "#.00"), cDark, color.white)
    f_cell(tbl, 3, 1, str.tostring(rst1, "#.00"), cDark, color.white)
    f_cell(tbl, 4, 1, entryValDisp1, cDark, color.white)
    f_cell(tbl, 5, 1, str.tostring(now1, "#.00"), cDark, color.white)
