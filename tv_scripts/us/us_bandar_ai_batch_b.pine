        alert(msg_7, alert.freq_once_per_bar_close)
    if st8 != "WAIT"
        msg_8 = "🔥 US BANDAR AI\nTicker: SOUN\nPrice: $" + str.tostring(c8, "#.##") + "\nSignal: " + st8 + "\nFlow: " + fl8 + "\nStrength: " + str.tostring(str8, "#.#") + "%"
        alert(msg_8, alert.freq_once_per_bar_close)
    if st9 != "WAIT"
        msg_9 = "🔥 US BANDAR AI\nTicker: SNAP\nPrice: $" + str.tostring(c9, "#.##") + "\nSignal: " + st9 + "\nFlow: " + fl9 + "\nStrength: " + str.tostring(str9, "#.#") + "%"
        alert(msg_9, alert.freq_once_per_bar_close)
    if st10 != "WAIT"
        msg_10 = "🔥 US BANDAR AI\nTicker: UBER\nPrice: $" + str.tostring(c10, "#.##") + "\nSignal: " + st10 + "\nFlow: " + fl10 + "\nStrength: " + str.tostring(str10, "#.#") + "%"
        alert(msg_10, alert.freq_once_per_bar_close)

plot(close, display=display.none)
