    f_cell(tbl, 7, 1, tp2ValDisp1, cDark, color.green)
    f_cell(tbl, 8, 1, slValDisp1, cDark, color.orange)
    f_cell(tbl, 9, 1, pnlDisp1, pnlBg1, color.white)
    f_cell(tbl, 10, 1, str.tostring(pctTp1_1, "#.##") + "%", pctTp1_1 >= 0 ? cGreen : cRed, color.white)
    f_cell(tbl, 11, 1, str.tostring(pctTp2_1, "#.##") + "%", pctTp2_1 >= 0 ? cGreen : cRed, color.white)
    f_cell(tbl, 12, 1, status1, f_status_color(status1), color.white)
    f_cell(tbl, 13, 1, zona1, f_zona_color(zona1), color.white)
    f_cell(tbl, 14, 1, str.tostring(rsi1, "#.0"), rsi1 < 30 ? cRed : rsi1 > 70 ? cOrange : cBlue, color.white)
    f_cell(tbl, 15, 1, macd1, f_macd_color(macd1), color.white)
