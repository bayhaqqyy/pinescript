2, tick2)) + '", "tp1": "' + (na(alertTp12) ? '-' : f_fmt_price(alertTp12, tick2)) + '", "tp2": "' + (na(alertTp22) ? '-' : f_fmt_price(alertTp22, tick2)) + '", "tp3": "' + (na(alertTp32) ? '-' : f_fmt_price(alertTp32, tick2)) + '", "sl": "' + (na(alertSl2) ? '-' : f_fmt_price(alertSl2, tick2)) + '"}, "time": ' + str.tostring(time) + '}'
    alert(msg_2, alert.freq_once_per_bar_close)
