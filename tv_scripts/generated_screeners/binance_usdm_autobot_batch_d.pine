3, tick3)) + '", "tp1": "' + (na(alertTp13) ? '-' : f_fmt_price(alertTp13, tick3)) + '", "tp2": "' + (na(alertTp23) ? '-' : f_fmt_price(alertTp23, tick3)) + '", "tp3": "' + (na(alertTp33) ? '-' : f_fmt_price(alertTp33, tick3)) + '", "sl": "' + (na(alertSl3) ? '-' : f_fmt_price(alertSl3, tick3)) + '"}, "time": ' + str.tostring(time) + '}'
