    lastBar2 := bar_index

anyTpHitLong3 = (not activeTp1Hit3 and hi3 >= activeTp13) or (activeTp1Hit3 and not activeTp2Hit3 and hi3 >= activeTp23) or (activeTp2Hit3 and not activeTp3Hit3 and hi3 >= activeTp33)
anyTpHitShort3 = (not activeTp1Hit3 and lo3 <= activeTp13) or (activeTp1Hit3 and not activeTp2Hit3 and lo3 <= activeTp23) or (activeTp2Hit3 and not activeTp3Hit3 and lo3 <= activeTp33)

longSlHit3 = activeSide3 == "LONG" and lo3 <= activeSl3
shortSlHit3 = activeSide3 == "SHORT" and hi3 >= activeSl3

bothHitLong3 = activeSide3 == "LONG" and anyTpHitLong3 and longSlHit3
bothHitShort3 = activeSide3 == "SHORT" and anyTpHitShort3 and shortSlHit3

tpHitValidLong3 = activeSide3 == "LONG" and anyTpHitLong3
slHitValidLong3 = longSlHit3

tpHitValidShort3 = activeSide3 == "SHORT" and anyTpHitShort3
slHitValidShort3 = shortSlHit3

if bothHitLong3
    if sameBarRule == "SL_FIRST"
        tpHitValidLong3 := false
    else if sameBarRule == "TP_FIRST"
        slHitValidLong3 := false
    else if sameBarRule == "IGNORE"
        tpHitValidLong3 := false
        slHitValidLong3 := false

if bothHitShort3
    if sameBarRule == "SL_FIRST"
        tpHitValidShort3 := false
    else if sameBarRule == "TP_FIRST"
        slHitValidShort3 := false
    else if sameBarRule == "IGNORE"
        tpHitValidShort3 := false
        slHitValidShort3 := false

entryEvent3 = activeSide3 == "" and plan3.action == 1.0 ? "LONG_ENTRY" : activeSide3 == "" and plan3.action == -1.0 ? "SHORT_ENTRY" : "NONE"

event3 = "NONE"
if activeSide3 == "LONG"
    if slHitValidLong3
        event3 := "LONG_SL_HIT"
    else if tpHitValidLong3
        if hi3 >= activeTp33 and activeTp2Hit3
            event3 := "LONG_TP3_HIT"
        else if hi3 >= activeTp23 and activeTp1Hit3
            event3 := "LONG_TP2_HIT"
        else if hi3 >= activeTp13
            event3 := "LONG_TP1_HIT"
else if activeSide3 == "SHORT"
    if slHitValidShort3
        event3 := "SHORT_SL_HIT"
    else if tpHitValidShort3
        if lo3 <= activeTp33 and activeTp2Hit3
            event3 := "SHORT_TP3_HIT"
        else if lo3 <= activeTp23 and activeTp1Hit3
            event3 := "SHORT_TP2_HIT"
        else if lo3 <= activeTp13
            event3 := "SHORT_TP1_HIT"
else
    event3 := entryEvent3

isEntryEvent3 = event3 == "LONG_ENTRY" or event3 == "SHORT_ENTRY"
alertSide3 = isEntryEvent3 ? (event3 == "LONG_ENTRY" ? "LONG" : "SHORT") : activeSide3
alertEntryLow3 = isEntryEvent3 ? plan3.entryLow : activeEntryLow3
alertEntryHigh3 = isEntryEvent3 ? plan3.entryHigh : activeEntryHigh3
alertEntryAvg3 = isEntryEvent3 ? plan3.entryAvg : activeEntryAvg3
alertTp13 = isEntryEvent3 ? plan3.tp1 : activeTp13
alertTp23 = isEntryEvent3 ? plan3.tp2 : activeTp23
alertTp33 = isEntryEvent3 ? plan3.tp3 : activeTp33
alertSl3 = isEntryEvent3 ? plan3.sl : activeSl3
alertModeRaw3 = isEntryEvent3 ? plan3.modeFlag : activeMode3

if event3 == "LONG_SL_HIT" or event3 == "LONG_TP3_HIT" or event3 == "SHORT_SL_HIT" or event3 == "SHORT_TP3_HIT"
    activeSide3 := ""
    activeEntryLow3 := na
    activeEntryHigh3 := na
    activeEntryAvg3 := na
    activeTp13 := na
    activeTp23 := na
    activeTp33 := na
    activeSl3 := na
    activeTp1Hit3 := false
    activeTp2Hit3 := false
    activeTp3Hit3 := false
    activeMode3 := na
else if event3 == "LONG_TP1_HIT" or event3 == "SHORT_TP1_HIT"
    activeTp1Hit3 := true
else if event3 == "LONG_TP2_HIT" or event3 == "SHORT_TP2_HIT"
    activeTp1Hit3 := true
    activeTp2Hit3 := true
else if event3 == "LONG_ENTRY" or event3 == "SHORT_ENTRY"
    activeSide3 := event3 == "LONG_ENTRY" ? "LONG" : "SHORT"
    activeEntryLow3 := plan3.entryLow
    activeEntryHigh3 := plan3.entryHigh
    activeEntryAvg3 := plan3.entryAvg
    activeTp13 := plan3.tp1
    activeTp23 := plan3.tp2
    activeTp33 := plan3.tp3
    activeSl3 := plan3.sl
    activeTp1Hit3 := false
    activeTp2Hit3 := false
    activeTp3Hit3 := false
    activeMode3 := plan3.modeFlag

sendAlert3 = event3 == "LONG_ENTRY" or event3 == "SHORT_ENTRY" or event3 == "LONG_TP1_HIT" or event3 == "LONG_TP2_HIT" or event3 == "LONG_TP3_HIT" or event3 == "LONG_SL_HIT" or event3 == "SHORT_TP1_HIT" or event3 == "SHORT_TP2_HIT" or event3 == "SHORT_TP3_HIT" or event3 == "SHORT_SL_HIT"
canAlert3 = sendAlert3 and (event3 != lastEvent3 or na(lastBar3) or bar_index - lastBar3 >= cooldownBars)

alertMode3 = alertModeRaw3 == 1.0 ? "TREND_CONTINUATION" : alertModeRaw3 == 2.0 ? "PULLBACK_ENTRY" : alertModeRaw3 == 3.0 ? "BREAKOUT_ENTRY" : alertModeRaw3 == 4.0 ? "BREAKDOWN_ENTRY" : alertModeRaw3 == 5.0 ? "SUPPLY_REJECTION" : alertModeRaw3 == 6.0 ? "DEMAND_REJECTION" : alertModeRaw3 == 7.0 ? "BREAKOUT_RETEST" : alertModeRaw3 == 8.0 ? "BREAKDOWN_RETEST" : "NONE"
triggerStr3 = plan3.action == 1.0 ? "BULLISH_CONFIRMATION" : plan3.action == -1.0 ? "BEARISH_CONFIRMATION" : "NEUTRAL"

if barstate.isconfirmed and canAlert3
