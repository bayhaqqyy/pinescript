        alert('{"type":"USDM_V12","batch":"D","ticker":"UNIUSDT","side":"' + sd6 + '","signal":"' + at6 + '","entry":' + ep6 + ',"tp":' + tp6 + ',"sl":' + sl6 + ',"lev":' + str.tostring(lev6) + ',"qty":' + qty6 + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar)
    if at7 != "WAIT"
