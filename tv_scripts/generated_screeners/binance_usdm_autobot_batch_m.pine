liqPriceLong4 = activeEntry4 * (1 - 0.90 / leverage)
liqPriceShort4 = activeEntry4 * (1 + 0.90 / leverage)
liqWarnLong4 = activeSl4 <= liqPriceLong4 ? "HIGH RISK" : activeSl4 <= liqPriceLong4 * 1.02 ? "WARNING" : "SAFE"
