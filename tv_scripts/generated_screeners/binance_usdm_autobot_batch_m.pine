var string activeSide4 = ""
var float activeEntry4 = na
var float activeTp4 = na
var float activeSl4 = na
var string lastEvent4 = ""
var int lastBar4 = na
var float activeMode4 = na

[now4, hi4, lo4, sup4, rst4, entry4, tp_4, sl_4, rsi4, rvolPct4, actionRaw4, score4, flowFlag4, statusFlag4, modeFlag4] = request.security(tk4, tf, f_dashboard_engine())

// Decode numeric flags to strings locally on chart
action4 = actionRaw4 == 1.0 ? "LONG" : actionRaw4 == -1.0 ? "SHORT" : "WAIT"
flow4 = flowFlag4 == 1.0 ? "LONG FLOW" : flowFlag4 == 2.0 ? "SHORT FLOW" : flowFlag4 == 3.0 ? "BUY ABSORB" : flowFlag4 == 4.0 ? "SELL ABSORB" : flowFlag4 == 5.0 ? "SQUEEZE" : flowFlag4 == 6.0 ? "SEPI" : "NORMAL"

buf4 = breakoutBufferPct / 100.0
