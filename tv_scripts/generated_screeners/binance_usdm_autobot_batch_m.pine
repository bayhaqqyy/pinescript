var tbl = table.new(tbl_pos, 20, 5, border_width=1, border_color=#333333)

if barstate.islast
    f_header(tbl, 0, "PAIR")
    f_header(tbl, 1, "TF")
    f_header(tbl, 2, "NOW")
    f_header(tbl, 3, "TRIG")
    f_header(tbl, 4, "ENTRY")
    f_header(tbl, 5, "TP")
    f_header(tbl, 6, "SL")
    f_header(tbl, 7, "TP%")
    f_header(tbl, 8, "RISK%")
    f_header(tbl, 9, "RR")
    f_header(tbl, 10, "PnL%")
    f_header(tbl, 11, "LEV")
    f_header(tbl, 12, "RISK")
    f_header(tbl, 13, "RSI")
    f_header(tbl, 14, "RVOL")
    f_header(tbl, 15, "FLOW")
    f_header(tbl, 16, "STATUS")
    f_header(tbl, 17, "ACTION")
    f_header(tbl, 18, "SCORE")
    f_header(tbl, 19, "SIGNAL")

    // Row 1
    f_cell(tbl, 0, 1, "MBOXUSDT", color.rgb(30, 90, 180), color.white)
    f_cell(tbl, 1, 1, tf, cDark, color.white)
    f_cell(tbl, 2, 1, f_fmt_price(now1, tick1), cDark, color.white)
    
    // TRIG
    trigDisp1 = f_fmt_price(longTrig1, tick1) + " / " + f_fmt_price(shortTrig1, tick1)
    f_cell(tbl, 3, 1, trigDisp1, cDark, color.white)
    
    // ENTRY, TP, SL, TP%, RISK%, RR display rules
    entryDisp1 = na(activeEntry1) ? "-" : f_fmt_price(activeEntry1, tick1)
    tpDisp1 = na(activeTp1) ? "-" : f_fmt_price(activeTp1, tick1)
    slDisp1 = na(activeSl1) ? "-" : f_fmt_price(activeSl1, tick1)
    pctTpDisp1 = na(pctTp1) ? "-" : str.tostring(pctTp1, "#.##") + "%"
    riskPctDisp1 = na(riskPct1) ? "-" : str.tostring(riskPct1, "#.##") + "%"
    rrDisp1 = na(rr1) ? "-" : str.tostring(rr1, "#.##")
    pnlDisp1 = na(pnlPct1) ? "-" : (pnlPct1 >= 0 ? "+" : "") + str.tostring(pnlPct1, "#.##") + "%"
    pnlBg1 = na(pnlPct1) ? cDark : (pnlPct1 >= 0 ? cGreen : cRed)
    
    f_cell(tbl, 4, 1, entryDisp1, cDark, color.white)
    f_cell(tbl, 5, 1, tpDisp1, cDark, color.lime)
