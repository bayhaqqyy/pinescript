[now3, hi3, lo3, sup3, rst3, entry3, tp_3, sl_3, rsi3, rvolPct3, actionRaw3, score3, flowFlag3, statusFlag3, modeFlag3] = request.security(tk3, tf, f_dashboard_engine())

