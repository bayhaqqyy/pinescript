    msg_7 = '{"market": "BINANCE_FUTURES", "type": "FUTURES_SIGNAL", "event": "' + event7 + '", "side": "' + str.tostring(alertSide7) + '", "symbol": "ENAUSDT", "tf": "' + tf + '", "now": ' + str.tostring(now7) + ', "entry": ' + str.tostring(alertEntry7) + ', "tp": ' + str.tostring(alertTp7) + ', "sl": ' + str.tostring(alertSl7) + ', "tp_pct": ' + str.tostring(alertTpPct7) + ', "risk_pct": ' + str.tostring(alertRiskPct7) + ', "rr": ' + str.tostring(alertRr7) + ', "leverage": ' + str.tostring(leverage) + ', "lev_tp_pct": ' + str.tostring(alertLevTp7) + ', "lev_risk_pct": ' + str.tostring(alertLevRisk7) + ', "risk_label": "' + risk7 + '", "liq_warn": "' + liqWarn7 + '", "bb_squeeze": "' + bbSqz7 + '", "max_safe_leverage": ' + str.tostring(maxSafeLev7) + ', "score": ' + str.tostring(score7) + ', "flow": "' + flow7 + '", "signal": "' + signal7 + '", "mode": "' + alertMode7 + '", "price_text": {"now": "' + f_fmt_price(now7, tick7) + '", "entry": "' + f_fmt_price(alertEntry7, tick7) + '", "tp": "' + f_fmt_price(alertTp7, tick7) + '", "sl": "' + f_fmt_price(alertSl7, tick7) + '"}, "tick_size": ' + str.tostring(tick7) + ', "price_decimals": ' + str.tostring(dec7) + ', "time": ' + str.tostring(time) + '}'
    alert(msg_7, alert.freq_once_per_bar_close)
    lastEvent7 := event7
    lastBar7 := bar_index

longTpHit8 = activeSide8 == "LONG" and hi8 >= activeTp8
longSlHit8 = activeSide8 == "LONG" and lo8 <= activeSl8
shortTpHit8 = activeSide8 == "SHORT" and lo8 <= activeTp8
shortSlHit8 = activeSide8 == "SHORT" and hi8 >= activeSl8

bothHitLong8 = longTpHit8 and longSlHit8
bothHitShort8 = shortTpHit8 and shortSlHit8

if bothHitLong8
    if sameBarRule == "SL_FIRST"
        longTpHit8 := false
    else if sameBarRule == "TP_FIRST"
        longSlHit8 := false
    else if sameBarRule == "IGNORE"
        longTpHit8 := false
        longSlHit8 := false

if bothHitShort8
    if sameBarRule == "SL_FIRST"
        shortTpHit8 := false
    else if sameBarRule == "TP_FIRST"
        shortSlHit8 := false
    else if sameBarRule == "IGNORE"
        shortTpHit8 := false
        shortSlHit8 := false

entryEvent8 = activeSide8 == "" and action8 == "LONG" ? "LONG_ENTRY" : activeSide8 == "" and action8 == "SHORT" ? "SHORT_ENTRY" : "NONE"
event8 = (activeSide8 == "LONG" and longTpHit8) ? "LONG_TP_HIT" : (activeSide8 == "LONG" and longSlHit8) ? "LONG_SL_HIT" : (activeSide8 == "SHORT" and shortTpHit8) ? "SHORT_TP_HIT" : (activeSide8 == "SHORT" and shortSlHit8) ? "SHORT_SL_HIT" : entryEvent8

alertSide8 = event8 == "LONG_ENTRY" ? "LONG" : event8 == "SHORT_ENTRY" ? "SHORT" : activeSide8
alertEntry8 = event8 == "LONG_ENTRY" or event8 == "SHORT_ENTRY" ? entry8 : activeEntry8
alertTp8 = event8 == "LONG_ENTRY" or event8 == "SHORT_ENTRY" ? tp_8 : activeTp8
alertSl8 = event8 == "LONG_ENTRY" or event8 == "SHORT_ENTRY" ? sl_8 : activeSl8

if event8 == "LONG_SL_HIT" or event8 == "LONG_TP_HIT" or event8 == "SHORT_SL_HIT" or event8 == "SHORT_TP_HIT"
    activeSide8 := ""
    activeEntry8 := na
    activeTp8 := na
    activeSl8 := na
    activeMode8 := na
else if event8 == "LONG_ENTRY"
    activeSide8 := "LONG"
    activeEntry8 := entry8
    activeTp8 := tp_8
    activeSl8 := sl_8
    activeMode8 := modeFlag8
else if event8 == "SHORT_ENTRY"
    activeSide8 := "SHORT"
    activeEntry8 := entry8
    activeTp8 := tp_8
    activeSl8 := sl_8
    activeMode8 := modeFlag8
    
sendAlert8 = event8 == "LONG_ENTRY" or event8 == "SHORT_ENTRY" or event8 == "LONG_TP_HIT" or event8 == "LONG_SL_HIT" or event8 == "SHORT_TP_HIT" or event8 == "SHORT_SL_HIT"
canAlert8 = sendAlert8 and (event8 != lastEvent8 or na(lastBar8) or bar_index - lastBar8 >= cooldownBars)

alertModeRaw8 = event8 == "LONG_ENTRY" or event8 == "SHORT_ENTRY" ? modeFlag8 : activeMode8
alertMode8 = alertModeRaw8 == 1.0 ? "TREND_SCALP" : alertModeRaw8 == 2.0 ? "PULLBACK_SCALP" : alertModeRaw8 == 3.0 ? "BREAKOUT_SCALP" : alertModeRaw8 == 4.0 ? "REVERSAL_ENTRY" : "NONE"

alertTpPct8 = not na(alertEntry8) and alertEntry8 > 0 ? math.abs(alertTp8 - alertEntry8) / alertEntry8 * 100.0 : 0.0
alertRiskPct8 = not na(alertEntry8) and alertEntry8 > 0 ? math.abs(alertEntry8 - alertSl8) / alertEntry8 * 100.0 : 0.0
alertRr8 = alertRiskPct8 == 0 ? 0.0 : alertTpPct8 / alertRiskPct8
alertLevTp8 = alertTpPct8 * leverage
alertLevRisk8 = alertRiskPct8 * leverage

if barstate.isconfirmed and canAlert8
    msg_8 = '{"market": "BINANCE_FUTURES", "type": "FUTURES_SIGNAL", "event": "' + event8 + '", "side": "' + str.tostring(alertSide8) + '", "symbol": "SANTOSUSDT", "tf": "' + tf + '", "now": ' + str.tostring(now8) + ', "entry": ' + str.tostring(alertEntry8) + ', "tp": ' + str.tostring(alertTp8) + ', "sl": ' + str.tostring(alertSl8) + ', "tp_pct": ' + str.tostring(alertTpPct8) + ', "risk_pct": ' + str.tostring(alertRiskPct8) + ', "rr": ' + str.tostring(alertRr8) + ', "leverage": ' + str.tostring(leverage) + ', "lev_tp_pct": ' + str.tostring(alertLevTp8) + ', "lev_risk_pct": ' + str.tostring(alertLevRisk8) + ', "risk_label": "' + risk8 + '", "liq_warn": "' + liqWarn8 + '", "bb_squeeze": "' + bbSqz8 + '", "max_safe_leverage": ' + str.tostring(maxSafeLev8) + ', "score": ' + str.tostring(score8) + ', "flow": "' + flow8 + '", "signal": "' + signal8 + '", "mode": "' + alertMode8 + '", "price_text": {"now": "' + f_fmt_price(now8, tick8) + '", "entry": "' + f_fmt_price(alertEntry8, tick8) + '", "tp": "' + f_fmt_price(alertTp8, tick8) + '", "sl": "' + f_fmt_price(alertSl8, tick8) + '"}, "tick_size": ' + str.tostring(tick8) + ', "price_decimals": ' + str.tostring(dec8) + ', "time": ' + str.tostring(time) + '}'
    alert(msg_8, alert.freq_once_per_bar_close)
    lastEvent8 := event8
    lastBar8 := bar_index


