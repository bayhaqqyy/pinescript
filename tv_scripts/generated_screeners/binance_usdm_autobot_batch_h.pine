longSlHit1 = activeSide1 == "LONG" and lo1 <= activeSl1
shortTpHit1 = activeSide1 == "SHORT" and lo1 <= activeTp1
shortSlHit1 = activeSide1 == "SHORT" and hi1 >= activeSl1

