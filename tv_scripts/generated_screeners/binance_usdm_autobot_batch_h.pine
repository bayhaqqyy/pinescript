bbSqz2 = "NORMAL"

pnlPct2 = activeSide2 == "LONG" ? ((now2 - activeEntry2) / activeEntry2) * 100.0 * leverage : activeSide2 == "SHORT" ? ((activeEntry2 - now2) / activeEntry2) * 100.0 * leverage : na
