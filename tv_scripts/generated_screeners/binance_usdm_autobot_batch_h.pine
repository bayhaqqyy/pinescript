risk4 = f_risk_label(levRiskPct4)

// Decode status locally using statusFlag and risk label
status4 = statusFlag4 == 1.0 ? "OVERHEAT" : statusFlag4 == 2.0 ? "OVERSOLD" : statusFlag4 == 3.0 ? "CONFLICT" : risk4 == "HIGH" ? "RISKY" : statusFlag4 == 4.0 ? "LONG SETUP" : statusFlag4 == 5.0 ? "SHORT SETUP" : "WATCH"
signal4 = action4 == "LONG" ? "LONG" : action4 == "SHORT" ? "SHORT" : risk4 == "HIGH" or risk4 == "RISKY" ? "RISKY" : "NEUTRAL"

