risk2 = f_risk_label(levRiskPct2)

// Decode status locally using statusFlag and risk label
status2 = statusFlag2 == 1.0 ? "OVERHEAT" : statusFlag2 == 2.0 ? "OVERSOLD" : statusFlag2 == 3.0 ? "CONFLICT" : risk2 == "HIGH" ? "RISKY" : statusFlag2 == 4.0 ? "LONG SETUP" : statusFlag2 == 5.0 ? "SHORT SETUP" : "WATCH"
signal2 = action2 == "LONG" ? "LONG" : action2 == "SHORT" ? "SHORT" : risk2 == "HIGH" or risk2 == "RISKY" ? "RISKY" : "NEUTRAL"

liqPriceLong2 = activeEntry2 * (1 - 0.90 / leverage)
