longSlHit4 = activeSide4 == "LONG" and low <= activeSl4
shortTpHit4 = activeSide4 == "SHORT" and low <= activeTp4
shortSlHit4 = activeSide4 == "SHORT" and high >= activeSl4

event4 = longSlHit4 or shortSlHit4 ? "SL_HIT" : longTpHit4 or shortTpHit4 ? "TP_HIT" : action4 == "LONG" ? "LONG_ENTRY" : action4 == "SHORT" ? "SHORT_ENTRY" : "NONE"

if event4 == "SL_HIT" or event4 == "TP_HIT"
    activeSide4 := ""
    activeEntry4 := na
    activeTp4 := na
    activeSl4 := na
else if event4 == "LONG_ENTRY"
    activeSide4 := "LONG"
    activeEntry4 := entry4
    activeTp4 := tp_4
    activeSl4 := sl_4
else if event4 == "SHORT_ENTRY"
    activeSide4 := "SHORT"
    activeEntry4 := entry4
    activeTp4 := tp_4
    activeSl4 := sl_4
    
sendAlert4 = event4 == "LONG_ENTRY" or event4 == "SHORT_ENTRY" or event4 == "TP_HIT" or event4 == "SL_HIT"
canAlert4 = sendAlert4 and (event4 != lastEvent4 or na(lastBar4) or bar_index - lastBar4 >= cooldownBars)

