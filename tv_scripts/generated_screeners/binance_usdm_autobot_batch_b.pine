// ============================================================================
// UI TABLE
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_right : pos == "Bottom Right" ? position.bottom_right : position.bottom_left
var tbl = table.new(tbl_pos, 17, 11, border_width=1, border_color=#333333)

if barstate.islast
    f_header(tbl, 0, "PAIR")
    f_header(tbl, 1, "TF")
    f_header(tbl, 2, "ENTRY")
    f_header(tbl, 3, "NOW")
    f_header(tbl, 4, "TP")
    f_header(tbl, 5, "SL")
    f_header(tbl, 6, "TP%")
    f_header(tbl, 7, "RISK%")
    f_header(tbl, 8, "RR")
    f_header(tbl, 9, "LEV")
    f_header(tbl, 10, "RISK")
    f_header(tbl, 11, "RSI")
    f_header(tbl, 12, "RVOL")
    f_header(tbl, 13, "FLOW")
    f_header(tbl, 14, "ACTION")
    f_header(tbl, 15, "SCORE")
    f_header(tbl, 16, "SIGNAL")

    // Row 1
    f_cell(tbl, 0, 1, "GRASSUSDT", color.rgb(30, 90, 180), color.white)
    f_cell(tbl, 1, 1, tf, cDark, color.white)
    f_cell(tbl, 2, 1, f_fmt_price(entry1, tick1), cDark, color.white)
    f_cell(tbl, 3, 1, f_fmt_price(now1, tick1), cDark, color.white)
    f_cell(tbl, 4, 1, f_fmt_price(tp_1, tick1), cDark, color.lime)
    f_cell(tbl, 5, 1, f_fmt_price(sl_1, tick1), cDark, color.orange)
    f_cell(tbl, 6, 1, str.tostring(pctTp1, "#.##") + "%", cDark, color.white)
    f_cell(tbl, 7, 1, str.tostring(riskPct1, "#.##") + "%", cDark, color.white)
    f_cell(tbl, 8, 1, str.tostring(rr1, "#.##"), cDark, color.white)
    f_cell(tbl, 9, 1, str.tostring(leverage) + "x", cDark, color.white)
    f_cell(tbl, 10, 1, risk1, f_risk_color(risk1), color.white)
    f_cell(tbl, 11, 1, str.tostring(rsi1, "#.0"), rsi1 < 30 ? cRed : rsi1 > 70 ? cOrange : cBlue, color.white)
    f_cell(tbl, 12, 1, str.tostring(rvolPct1, "#.0") + "%", rvolPct1 >= 120 ? cGreen : cDark, color.white)
    f_cell(tbl, 13, 1, flow1, cDark, color.white)
    f_cell(tbl, 14, 1, action1, f_action_color(action1), color.white)
    f_cell(tbl, 15, 1, str.tostring(score1, "#"), f_score_color(score1), color.white)
    f_cell(tbl, 16, 1, signal1, f_signal_color(signal1), color.white)
    // Row 2
    f_cell(tbl, 0, 2, "FIDAUSDT", color.rgb(30, 90, 180), color.white)
    f_cell(tbl, 1, 2, tf, cDark, color.white)
    f_cell(tbl, 2, 2, f_fmt_price(entry2, tick2), cDark, color.white)
    f_cell(tbl, 3, 2, f_fmt_price(now2, tick2), cDark, color.white)
    f_cell(tbl, 4, 2, f_fmt_price(tp_2, tick2), cDark, color.lime)
    f_cell(tbl, 5, 2, f_fmt_price(sl_2, tick2), cDark, color.orange)
    f_cell(tbl, 6, 2, str.tostring(pctTp2, "#.##") + "%", cDark, color.white)
    f_cell(tbl, 7, 2, str.tostring(riskPct2, "#.##") + "%", cDark, color.white)
    f_cell(tbl, 8, 2, str.tostring(rr2, "#.##"), cDark, color.white)
    f_cell(tbl, 9, 2, str.tostring(leverage) + "x", cDark, color.white)
    f_cell(tbl, 10, 2, risk2, f_risk_color(risk2), color.white)
    f_cell(tbl, 11, 2, str.tostring(rsi2, "#.0"), rsi2 < 30 ? cRed : rsi2 > 70 ? cOrange : cBlue, color.white)
    f_cell(tbl, 12, 2, str.tostring(rvolPct2, "#.0") + "%", rvolPct2 >= 120 ? cGreen : cDark, color.white)
    f_cell(tbl, 13, 2, flow2, cDark, color.white)
