// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// Strategy: BTC QUANTUM SIGNAL V2 (ZERO-LAG SCALPING)
// Optimized strictly for Bitcoin (BTCUSD/BTCUSDT) 24/7 market.

//@version=6
indicator("BTC QUANTUM SIGNAL V2", overlay=true, max_bars_back=500)

// ============================================================================
// FAILSAFE: LOCK ONLY FOR BITCOIN
// ============================================================================
isBTC = str.contains(syminfo.tickerid, "BTC")
if not isBTC
    runtime.error("Sistem di-lock KHUSUS untuk Bitcoin. Silakan pindah ke chart BTCUSD/BTCUSDT.")

// ============================================================================
// INPUT - FAST MOMENTUM ENGINE (DIUBAH UNTUK MENGHILANGKAN LAG)
// ============================================================================
// Menggunakan EMA 5 dan 13 agar sinyal tidak telat
emaFastLen  = input.int(5,  "EMA Fast", minval=2, group="Momentum Engine")
emaSlowLen  = input.int(13, "EMA Slow", minval=2, group="Momentum Engine")
emaTrendLen = input.int(200, "EMA Trend (Macro)", minval=50, group="Momentum Engine")

macdFast   = input.int(12, "MACD Fast",   minval=1, group="MACD")
macdSlow   = input.int(26, "MACD Slow",   minval=1, group="MACD")
macdSignal = input.int(9,  "MACD Signal", minval=1, group="MACD")

rsiLen = input.int(14, "RSI Length", group="RSI Filter")
rsiMaxBuy  = input.int(75, "Max RSI BUY", group="RSI Filter")
rsiMinSell = input.int(25, "Min RSI SELL", group="RSI Filter")

atrPeriod  = input.int(14,    "ATR Period", minval=1, group="ATR Levels")
atrMultTP1 = input.float(1.5, "ATR Mult TP1", minval=0.1, step=0.1, group="ATR Levels")
atrMultTP2 = input.float(3.0, "ATR Mult TP2", minval=0.1, step=0.1, group="ATR Levels")
atrMultSL  = input.float(2.0, "ATR Mult SL (Tightened)",  minval=0.1, step=0.1, group="ATR Levels")

// ============================================================================
// CALCULATIONS
// ============================================================================
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)

// Deteksi persilangan yang super cepat
emaCrossUp   = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)

[macdLine, sigLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)
// EARLY MACD: Tidak menunggu nol, tapi mendeteksi perpotongan garis momentum
macdBullish = macdLine > sigLine
macdBearish = macdLine < sigLine

rsiValue = ta.rsi(close, rsiLen)
atrValue = ta.atr(atrPeriod)
signalReady = bar_index >= (atrPeriod > emaTrendLen ? atrPeriod : emaTrendLen)

// ============================================================================
// SIGNAL DETECTION (ZERO-LAG LOGIC)
// ============================================================================
// Entry dipaksa lebih awal: Fast Cross + MACD Bullish + Harga di atas EMA 13
buySignal  = barstate.isconfirmed and signalReady and emaCrossUp and macdBullish and close > emaTrend and rsiValue < rsiMaxBuy
sellSignal = barstate.isconfirmed and signalReady and emaCrossDown and macdBearish and close < emaTrend and rsiValue > rsiMinSell

// ============================================================================
// LEVEL PROJECTIONS
// ============================================================================
entryPrice = close

buyTP1 = entryPrice + atrMultTP1 * atrValue
buyTP2 = entryPrice + atrMultTP2 * atrValue
buySL  = entryPrice - atrMultSL  * atrValue

sellTP1 = entryPrice - atrMultTP1 * atrValue
sellTP2 = entryPrice - atrMultTP2 * atrValue
sellSL  = entryPrice + atrMultSL  * atrValue

tp1Level = buySignal ? buyTP1 : sellTP1
tp2Level = buySignal ? buyTP2 : sellTP2
slLevel  = buySignal ? buySL  : sellSL

// ============================================================================
// VISUAL FEEDBACK
// ============================================================================
plotshape(buySignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="BUY")
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,  0), size=size.small, text="SELL")
plot(emaFast, color=color.new(color.fuchsia, 0), title="EMA 5 (Fast)")
plot(emaSlow, color=color.new(color.yellow, 0), title="EMA 13 (Slow)")
plot(emaTrend, color=color.rgb(247, 147, 26, 30), linewidth=2, title="EMA 200 (BTC Orange)")

// ============================================================================
// ALERT PAYLOAD (FORMATTED FOR WEBHOOK)
// ============================================================================
if buySignal or sellSignal
    actionStr  = buySignal ? "BUY" : "SELL"
    contextRaw = actionStr + " — Fast EMA " + str.tostring(emaFastLen) + " Cross, MACD Lead, RSI:" + str.tostring(math.round(rsiValue))
    
    alertMsg = "₿ BTC QUANTUM SIGNAL\n" +
               "Ticker: "  + syminfo.ticker + "\n" +
               "Action: "  + actionStr + "\n" +
               "Entry: "   + str.tostring(entryPrice, format.mintick) + "\n" +
               "TP1: "     + str.tostring(tp1Level,   format.mintick) + "\n" +
               "TP2: "     + str.tostring(tp2Level,   format.mintick) + "\n" +
               "SL: "      + str.tostring(slLevel,    format.mintick) + "\n" +
               "Context: " + contextRaw

    alert(alertMsg, alert.freq_once_per_bar_close)