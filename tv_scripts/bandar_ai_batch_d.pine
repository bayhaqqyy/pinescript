// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// Generated on 2026-05-12 | Strategy: BANDAR AI (Swing Detection)
//
// @description Bandar AI screener untuk saham IDX mid-cap dan blue chip.
//   Default Timeframe: 10 menit. Holding period: hari-minggu (swing).
//   Strategi: EMA 200 Trend + Volume Spike + Candle Absorption Pattern.
//   Sinyal: SNIPER BUY (bullish trend + vol spike), BULL ABSORB (lower wick absorption),
//           SNIPER SELL (bearish trend + vol spike), BEAR ABSORB (upper wick absorption).
//   Cocok untuk mendeteksi akumulasi/distribusi bandar dan institusi.

//@version=6
indicator("BANDAR AI SCREENER - BATCH D (10 Emiten)", overlay=true, max_bars_back=500)

// ============================================================================
// INPUT
// ============================================================================
tf             = input.timeframe("10", "Timeframe Screener")
emaSlowLen     = input.int(200, "EMA Trend")
volMultiplier  = input.float(1.5, "Vol Spike Multiplier")
pos            = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// ============================================================================
// TICKER DEFINITIONS (harga per 2026-05-12)
// ============================================================================
tk1 = "IDX:BJBR"  // ~Rp795
tk2 = "IDX:BJTM"  // ~Rp595
tk3 = "IDX:BBTN"  // ~Rp1200
tk4 = "IDX:BFIN"  // ~Rp765
tk5 = "IDX:ASSA"  // ~Rp770
tk6 = "IDX:EMTK"  // ~Rp730
tk7 = "IDX:SCMA"  // ~Rp246
tk8 = "IDX:MNCN"  // ~Rp222
tk9 = "IDX:KAEF"  // ~Rp630
tk10 = "IDX:KLBF"  // ~Rp870

// ============================================================================
// CORE ENGINE FUNCTION (Dihitung di masing-masing emiten)
// ============================================================================
f_engine(ema_len, vol_mult) =>
    emaSlow = ta.ema(close, ema_len)
    bullTrend = close > emaSlow
    bearTrend = close < emaSlow
    
    volMA = ta.sma(volume, 20)
    volSpike = volume > volMA * vol_mult
    
    body = math.abs(close - open)
    candleRange = high - low
    lowerWick = math.min(open, close) - low
    upperWick = high - math.max(open, close)
    
    bullAbsorb = lowerWick > body * 1.1 and volume > volMA * 1.3 and close > low + (candleRange * 0.4)
    bearAbsorb = upperWick > body * 1.1 and volume > volMA * 1.3 and close < high - (candleRange * 0.4)
    
    sniperBuy = bullTrend and volSpike and (close > open)
    sniperSell = bearTrend and volSpike and (close < open)
    
    // Status Text
    status = sniperBuy ? "SNIPER BUY" : sniperSell ? "SNIPER SELL" : bullAbsorb ? "BULL ABSORB" : bearAbsorb ? "BEAR ABSORB" : "WAIT"
    [close, status]

// ============================================================================
// DATA FETCH (request.security)
// ============================================================================
[c1, st1] = request.security(tk1, tf, f_engine(emaSlowLen, volMultiplier))
[c2, st2] = request.security(tk2, tf, f_engine(emaSlowLen, volMultiplier))
[c3, st3] = request.security(tk3, tf, f_engine(emaSlowLen, volMultiplier))
[c4, st4] = request.security(tk4, tf, f_engine(emaSlowLen, volMultiplier))
[c5, st5] = request.security(tk5, tf, f_engine(emaSlowLen, volMultiplier))
[c6, st6] = request.security(tk6, tf, f_engine(emaSlowLen, volMultiplier))
[c7, st7] = request.security(tk7, tf, f_engine(emaSlowLen, volMultiplier))
[c8, st8] = request.security(tk8, tf, f_engine(emaSlowLen, volMultiplier))
[c9, st9] = request.security(tk9, tf, f_engine(emaSlowLen, volMultiplier))
[c10, st10] = request.security(tk10, tf, f_engine(emaSlowLen, volMultiplier))

// ============================================================================
// TABLE DISPLAY
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left
var tbl = table.new(tbl_pos, 3, 11, border_width=1, border_color=#333333)

f_get_color(st) =>
    st == "SNIPER BUY" ? color.lime : st == "SNIPER SELL" ? color.red : st == "BULL ABSORB" ? color.aqua : st == "BEAR ABSORB" ? color.orange : color.gray

if barstate.islast
    // Header
    hdr_bg = #6a0dad
    hdr_clr = color.white
    table.cell(tbl, 0, 0, "EMITEN", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 1, 0, "PRICE", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 2, 0, "SIGNAL", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    
    table.cell(tbl, 0, 1, "BJBR", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(c1, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 1, st1, text_color=color.black, bgcolor=f_get_color(st1), text_size=size.small)
    table.cell(tbl, 0, 2, "BJTM", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(c2, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 2, st2, text_color=color.black, bgcolor=f_get_color(st2), text_size=size.small)
    table.cell(tbl, 0, 3, "BBTN", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(c3, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 3, st3, text_color=color.black, bgcolor=f_get_color(st3), text_size=size.small)
    table.cell(tbl, 0, 4, "BFIN", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(c4, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 4, st4, text_color=color.black, bgcolor=f_get_color(st4), text_size=size.small)
    table.cell(tbl, 0, 5, "ASSA", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(c5, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 5, st5, text_color=color.black, bgcolor=f_get_color(st5), text_size=size.small)
    table.cell(tbl, 0, 6, "EMTK", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(c6, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 6, st6, text_color=color.black, bgcolor=f_get_color(st6), text_size=size.small)
    table.cell(tbl, 0, 7, "SCMA", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(c7, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 7, st7, text_color=color.black, bgcolor=f_get_color(st7), text_size=size.small)
    table.cell(tbl, 0, 8, "MNCN", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(c8, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 8, st8, text_color=color.black, bgcolor=f_get_color(st8), text_size=size.small)
    table.cell(tbl, 0, 9, "KAEF", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 9, str.tostring(c9, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 9, st9, text_color=color.black, bgcolor=f_get_color(st9), text_size=size.small)
    table.cell(tbl, 0, 10, "KLBF", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 10, str.tostring(c10, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 10, st10, text_color=color.black, bgcolor=f_get_color(st10), text_size=size.small)

// ============================================================================
// ALERTS UNTUK TELEGRAM (JSON PAYLOAD)
// ============================================================================
if barstate.islast and barstate.isconfirmed
    if st1 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"BJBR","price":' + str.tostring(c1) + ',"signal":"' + st1 + '"}', alert.freq_once_per_bar_close)
    if st2 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"BJTM","price":' + str.tostring(c2) + ',"signal":"' + st2 + '"}', alert.freq_once_per_bar_close)
    if st3 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"BBTN","price":' + str.tostring(c3) + ',"signal":"' + st3 + '"}', alert.freq_once_per_bar_close)
    if st4 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"BFIN","price":' + str.tostring(c4) + ',"signal":"' + st4 + '"}', alert.freq_once_per_bar_close)
    if st5 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"ASSA","price":' + str.tostring(c5) + ',"signal":"' + st5 + '"}', alert.freq_once_per_bar_close)
    if st6 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"EMTK","price":' + str.tostring(c6) + ',"signal":"' + st6 + '"}', alert.freq_once_per_bar_close)
    if st7 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"SCMA","price":' + str.tostring(c7) + ',"signal":"' + st7 + '"}', alert.freq_once_per_bar_close)
    if st8 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"MNCN","price":' + str.tostring(c8) + ',"signal":"' + st8 + '"}', alert.freq_once_per_bar_close)
    if st9 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"KAEF","price":' + str.tostring(c9) + ',"signal":"' + st9 + '"}', alert.freq_once_per_bar_close)
    if st10 != "WAIT"
        alert('{"type":"BANDAR_AI","batch":"D","ticker":"KLBF","price":' + str.tostring(c10) + ',"signal":"' + st10 + '"}', alert.freq_once_per_bar_close)

plot(close, display=display.none)
