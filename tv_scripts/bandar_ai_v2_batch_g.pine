        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"ERAA","tf":"' + tf + '","signal":"' + st_3 + '","entry":' + str.tostring(entry_3) + ',"tp1":' + str.tostring(tp1_3) + ',"tp2":' + str.tostring(tp2_3) + ',"sl":' + str.tostring(sl_3) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_3) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_4 == "SNIPER BUY" or st_4 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"ACES","tf":"' + tf + '","signal":"' + st_4 + '","entry":' + str.tostring(entry_4) + ',"tp1":' + str.tostring(tp1_4) + ',"tp2":' + str.tostring(tp2_4) + ',"sl":' + str.tostring(sl_4) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_4) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_5 == "SNIPER BUY" or st_5 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"INDS","tf":"' + tf + '","signal":"' + st_5 + '","entry":' + str.tostring(entry_5) + ',"tp1":' + str.tostring(tp1_5) + ',"tp2":' + str.tostring(tp2_5) + ',"sl":' + str.tostring(sl_5) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_5) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_6 == "SNIPER BUY" or st_6 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"AMOR","tf":"' + tf + '","signal":"' + st_6 + '","entry":' + str.tostring(entry_6) + ',"tp1":' + str.tostring(tp1_6) + ',"tp2":' + str.tostring(tp2_6) + ',"sl":' + str.tostring(sl_6) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_6) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_7 == "SNIPER BUY" or st_7 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"SGER","tf":"' + tf + '","signal":"' + st_7 + '","entry":' + str.tostring(entry_7) + ',"tp1":' + str.tostring(tp1_7) + ',"tp2":' + str.tostring(tp2_7) + ',"sl":' + str.tostring(sl_7) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_7) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_8 == "SNIPER BUY" or st_8 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"SAFE","tf":"' + tf + '","signal":"' + st_8 + '","entry":' + str.tostring(entry_8) + ',"tp1":' + str.tostring(tp1_8) + ',"tp2":' + str.tostring(tp2_8) + ',"sl":' + str.tostring(sl_8) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_8) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_9 == "SNIPER BUY" or st_9 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"CFIN","tf":"' + tf + '","signal":"' + st_9 + '","entry":' + str.tostring(entry_9) + ',"tp1":' + str.tostring(tp1_9) + ',"tp2":' + str.tostring(tp2_9) + ',"sl":' + str.tostring(sl_9) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_9) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_10 == "SNIPER BUY" or st_10 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"MINA","tf":"' + tf + '","signal":"' + st_10 + '","entry":' + str.tostring(entry_10) + ',"tp1":' + str.tostring(tp1_10) + ',"tp2":' + str.tostring(tp2_10) + ',"sl":' + str.tostring(sl_10) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_10) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)

