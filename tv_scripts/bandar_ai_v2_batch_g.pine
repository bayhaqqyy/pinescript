    table.cell(tbl, 2, 10, str.tostring(tv_10/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, 10, st_10, text_color=color.black, bgcolor=f_get_color(st_10), text_size=size.small)

// ============================================================================
// ALERTS UNTUK TELEGRAM (JSON PAYLOAD)
// ============================================================================
if barstate.islast and barstate.isconfirmed
    if st_1 == "SNIPER BUY" or st_1 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"LPIN","tf":"' + tf + '","signal":"' + st_1 + '","entry":' + str.tostring(entry_1) + ',"tp1":' + str.tostring(tp1_1) + ',"tp2":' + str.tostring(tp2_1) + ',"sl":' + str.tostring(sl_1) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_1) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if st_2 == "SNIPER BUY" or st_2 == "BULL ABSORB"
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"CLEO","tf":"' + tf + '","signal":"' + st_2 + '","entry":' + str.tostring(entry_2) + ',"tp1":' + str.tostring(tp1_2) + ',"tp2":' + str.tostring(tp2_2) + ',"sl":' + str.tostring(sl_2) + ',"holding_hint":"swing 3-7 hari","transaction_value":' + str.tostring(tv_2) + ',"time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
