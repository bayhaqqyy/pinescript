rs_c4  = rsi4 < 30 ? color.lime : rsi4 > 70 ? color.red : color.white
rv_c4  = rvol4 > 2 ? color.lime : rvol4 > 1 ? color.yellow : color.gray
// --- FOOD ---
pv5 = (h5[1] + l5[1] + c5[1]) / 3
entry5 = math.round(2 * pv5 - h5[1])
tv_5 = v5 * c5

tp1_5 = math.round(entry5 + (atr_5 * tp1_mult))
