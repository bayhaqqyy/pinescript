// ALERTS - Webhook JSON
// ============================================================================
if barstate.islast and barstate.isconfirmed
    if st_1 == "HAKA" and tv_1 >= min_tv
        alert('{"type":"SCALP","tier":"SCALP_GORENGAN","ticker":"AMAR","tf":"' + tf + '","signal":"HAKA","entry":' + str.tostring(c1) + ',"tp1":' + str.tostring(tp1_1) + ',"tp2":' + str.tostring(tp2_1) + ',"sl":' + str.tostring(sl_1) + ',"holding_hint":"intraday","time":' + str.tostring(time) + '}', alert.freq_once_per_bar)
    if st_2 == "HAKA" and tv_2 >= min_tv
        alert('{"type":"SCALP","tier":"SCALP_GORENGAN","ticker":"ADHI","tf":"' + tf + '","signal":"HAKA","entry":' + str.tostring(c2) + ',"tp1":' + str.tostring(tp1_2) + ',"tp2":' + str.tostring(tp2_2) + ',"sl":' + str.tostring(sl_2) + ',"holding_hint":"intraday","time":' + str.tostring(time) + '}', alert.freq_once_per_bar)
