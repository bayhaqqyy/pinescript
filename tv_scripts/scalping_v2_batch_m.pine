    table.cell(tbl, 5, 1, st_1, text_color=color.black, bgcolor=st_c1, text_size=size.small)
    table.cell(tbl, 6, 1, str.tostring(rsi_1, "#.#"), text_color=rs_c1, bgcolor=#1a1a2e, text_size=size.small)
