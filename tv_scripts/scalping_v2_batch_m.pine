rs_c6  = rsi6 < 30 ? color.lime : rsi6 > 70 ? color.red : color.white
rv_c6  = rvol6 > 2 ? color.lime : rvol6 > 1 ? color.yellow : color.gray
// --- HUMI ---
pv7 = (h7[1] + l7[1] + c7[1]) / 3
entry7 = math.round(2 * pv7 - h7[1])
tv_7 = v7 * c7

tp1_7 = math.round(entry7 + (atr_7 * tp1_mult))
tp2_7 = math.round(entry7 + (atr_7 * tp2_mult))
