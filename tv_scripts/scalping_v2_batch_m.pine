// ============================================================================
// TABLE DISPLAY
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left

var tbl = table.new(tbl_pos, 11, 11, border_width=1, border_color=#333333)

if barstate.islast
    // Header row
    hdr_bg = #ff8c00
    hdr_clr = color.black
    table.cell(tbl, 0, 0, "EMITEN", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 1, 0, "TF", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 2, 0, "ENTRY", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 3, 0, "NOW", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 4, 0, "TP1", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 5, 0, "TP2", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 6, 0, "SL", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 7, 0, "STATUS", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 8, 0, "RSI", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 9, 0, "RVOL", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 10, 0, "VALUE", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)

if barstate.islast
    // Row 1: AMAR
    row1 = 1
    table.cell(tbl, 0, row1, "AMAR", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, row1, tf, text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, row1, str.tostring(entry1, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, row1, str.tostring(c1, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 4, row1, str.tostring(tp1_1, "#"), text_color=color.lime, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 5, row1, str.tostring(tp2_1, "#"), text_color=color.lime, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 6, row1, str.tostring(sl_1, "#"), text_color=color.red, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 7, row1, st1, text_color=color.black, bgcolor=st_c1, text_size=size.small)
    table.cell(tbl, 8, row1, str.tostring(rsi1, "#.#"), text_color=rs_c1, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 9, row1, str.tostring(rvol1, "#.##"), text_color=rv_c1, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 10, row1, tv_1 > 1e9 ? str.tostring(tv_1/1e9, "#.#") + "B" : str.tostring(tv_1/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    // Row 2: ADHI
    row2 = 2
    table.cell(tbl, 0, row2, "ADHI", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, row2, tf, text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, row2, str.tostring(entry2, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, row2, str.tostring(c2, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 4, row2, str.tostring(tp1_2, "#"), text_color=color.lime, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 5, row2, str.tostring(tp2_2, "#"), text_color=color.lime, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 6, row2, str.tostring(sl_2, "#"), text_color=color.red, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 7, row2, st2, text_color=color.black, bgcolor=st_c2, text_size=size.small)
    table.cell(tbl, 8, row2, str.tostring(rsi2, "#.#"), text_color=rs_c2, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 9, row2, str.tostring(rvol2, "#.##"), text_color=rv_c2, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 10, row2, tv_2 > 1e9 ? str.tostring(tv_2/1e9, "#.#") + "B" : str.tostring(tv_2/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    // Row 3: HELI
    row3 = 3
    table.cell(tbl, 0, row3, "HELI", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, row3, tf, text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
