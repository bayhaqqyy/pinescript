// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// Generated on 2026-05-19 | Strategy: SCALPING_V2 (Anti-ARB Engine)
//@version=6
indicator("SCALPING V2 - BATCH M (10 Emiten)", overlay=true, max_bars_back=500)

// ============================================================================
// INPUT
// ============================================================================
tf = input.timeframe("5", "Timeframe Screener")
min_tv = input.float(500000000, "Min Transaction Value per Bar (Rp)")
tp1_mult = input.float(1.0, "TP1 ATR Multiplier")
tp2_mult = input.float(2.0, "TP2 ATR Multiplier")
sl_mult  = input.float(1.5, "SL ATR Multiplier") // SL dilebarkan sedikit untuk volatilitas
pos = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// ============================================================================
// TICKER DEFINITIONS
// ============================================================================
tk1 = "IDX:AMAR"  // SCALP_GORENGAN
tk2 = "IDX:ADHI"  // SCALP_GORENGAN
tk3 = "IDX:HELI"  // SCALP_GORENGAN
tk4 = "IDX:SMBR"  // SCALP_GORENGAN
tk5 = "IDX:FOOD"  // SCALP_GORENGAN
tk6 = "IDX:NIRO"  // SCALP_GORENGAN
tk7 = "IDX:HUMI"  // SCALP_GORENGAN
tk8 = "IDX:BMHS"  // SCALP_GORENGAN
tk9 = "IDX:GZCO"  // SCALP_GORENGAN
tk10 = "IDX:AGRO"  // SCALP_GORENGAN

// ============================================================================
// CORE ENGINE FUNCTION (ANTI FALLING KNIFE)
// ============================================================================
f_scalp_engine() =>
    emaFast = ta.ema(close, 5)
    
    // Filter Price Action Ketat
    isGreenCandle = close > open
    isNotARB = close > low
    
    // Analisis Volume & Momentum
    volMA = ta.sma(volume, 20)
    rvol = volMA > 0 ? volume / volMA : 0
    rsiVal = ta.rsi(close, 14)
    
    // Syarat HAKA: Harus hijau, tidak ARB, volume meledak, di atas EMA 5
    validHaka = isGreenCandle and isNotARB and (rvol > 1.5) and (close > emaFast)
    
    status = validHaka ? "HAKA" : "WAIT"
    atr_val = ta.atr(14)
    
    [close, status, rsiVal, rvol, atr_val]

// ============================================================================
// DATA FETCH - request.security
// ============================================================================
[c1, st_1, rsi_1, rvol_1, atr_1] = request.security(tk1, tf, f_scalp_engine())
[c2, st_2, rsi_2, rvol_2, atr_2] = request.security(tk2, tf, f_scalp_engine())
[c3, st_3, rsi_3, rvol_3, atr_3] = request.security(tk3, tf, f_scalp_engine())
[c4, st_4, rsi_4, rvol_4, atr_4] = request.security(tk4, tf, f_scalp_engine())
[c5, st_5, rsi_5, rvol_5, atr_5] = request.security(tk5, tf, f_scalp_engine())
[c6, st_6, rsi_6, rvol_6, atr_6] = request.security(tk6, tf, f_scalp_engine())
[c7, st_7, rsi_7, rvol_7, atr_7] = request.security(tk7, tf, f_scalp_engine())
[c8, st_8, rsi_8, rvol_8, atr_8] = request.security(tk8, tf, f_scalp_engine())
[c9, st_9, rsi_9, rvol_9, atr_9] = request.security(tk9, tf, f_scalp_engine())
[c10, st_10, rsi_10, rvol_10, atr_10] = request.security(tk10, tf, f_scalp_engine())

// ============================================================================
// CALCULATIONS
// ============================================================================
// --- Calculation Ticker 1 ---
tp1_1 = math.round(c1 + (atr_1 * tp1_mult))
tp2_1 = math.round(c1 + (atr_1 * tp2_mult))
sl_1  = math.round(c1 - (atr_1 * sl_mult))
tv_1  = volume * c1

st_c1 = st_1 == "HAKA" ? color.lime : color.gray
rs_c1 = rsi_1 < 30 ? color.lime : rsi_1 > 70 ? color.red : color.white
rv_c1 = rvol_1 > 2 ? color.lime : rvol_1 > 1.5 ? color.yellow : color.gray
// --- Calculation Ticker 2 ---
tp1_2 = math.round(c2 + (atr_2 * tp1_mult))
tp2_2 = math.round(c2 + (atr_2 * tp2_mult))
sl_2  = math.round(c2 - (atr_2 * sl_mult))
tv_2  = volume * c2

