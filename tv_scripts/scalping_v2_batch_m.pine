// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// Generated on 2026-05-19 | Strategy: SCALPING_V2 (Intraday)
//
// @description Scalping screener v2 untuk penny stocks.
//   Default Timeframe: 5 menit. Holding period: intraday.

//@version=6
indicator("SCALPING V2 - BATCH M (10 Emiten)", overlay=true, max_bars_back=500)

// ============================================================================
// INPUT
// ============================================================================
tf = input.timeframe("5", "Timeframe Screener")
min_tv = input.float(500000000, "Min Transaction Value per Bar (Rp)")
tp1_mult = input.float(1.0, "TP1 ATR Multiplier")
tp2_mult = input.float(2.0, "TP2 ATR Multiplier")
sl_mult  = input.float(1.0, "SL ATR Multiplier")
pos = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// ============================================================================
// TICKER DEFINITIONS (harga per 2026-05-19)
// ============================================================================
tk1 = "IDX:AMAR"  // SCALP_GORENGAN
tk2 = "IDX:ADHI"  // SCALP_GORENGAN
tk3 = "IDX:HELI"  // SCALP_GORENGAN
tk4 = "IDX:SMBR"  // SCALP_GORENGAN
tk5 = "IDX:FOOD"  // SCALP_GORENGAN
tk6 = "IDX:NIRO"  // SCALP_GORENGAN
tk7 = "IDX:HUMI"  // SCALP_GORENGAN
tk8 = "IDX:BMHS"  // SCALP_GORENGAN
tk9 = "IDX:GZCO"  // SCALP_GORENGAN
tk10 = "IDX:AGRO"  // SCALP_GORENGAN

// ============================================================================
// DATA FETCH - request.security
// ============================================================================
[c1, h1, l1, v1, o1, atr_1] = request.security(tk1, tf, [close, high, low, volume, open, ta.atr(14)])
[c2, h2, l2, v2, o2, atr_2] = request.security(tk2, tf, [close, high, low, volume, open, ta.atr(14)])
[c3, h3, l3, v3, o3, atr_3] = request.security(tk3, tf, [close, high, low, volume, open, ta.atr(14)])
[c4, h4, l4, v4, o4, atr_4] = request.security(tk4, tf, [close, high, low, volume, open, ta.atr(14)])
[c5, h5, l5, v5, o5, atr_5] = request.security(tk5, tf, [close, high, low, volume, open, ta.atr(14)])
[c6, h6, l6, v6, o6, atr_6] = request.security(tk6, tf, [close, high, low, volume, open, ta.atr(14)])
[c7, h7, l7, v7, o7, atr_7] = request.security(tk7, tf, [close, high, low, volume, open, ta.atr(14)])
[c8, h8, l8, v8, o8, atr_8] = request.security(tk8, tf, [close, high, low, volume, open, ta.atr(14)])
[c9, h9, l9, v9, o9, atr_9] = request.security(tk9, tf, [close, high, low, volume, open, ta.atr(14)])
[c10, h10, l10, v10, o10, atr_10] = request.security(tk10, tf, [close, high, low, volume, open, ta.atr(14)])

// ============================================================================
// CALCULATIONS
// ============================================================================
// --- AMAR ---
pv1 = (h1[1] + l1[1] + c1[1]) / 3
entry1 = math.round(2 * pv1 - h1[1])
tv_1 = v1 * c1

tp1_1 = math.round(entry1 + (atr_1 * tp1_mult))
tp2_1 = math.round(entry1 + (atr_1 * tp2_mult))
sl_1  = math.round(entry1 - (atr_1 * sl_mult))

rsi1   = ta.rsi(c1, 14)
avgv1  = ta.sma(v1, 20)
rvol1  = avgv1 > 0 ? v1 / avgv1 : 0

// Base signal
sig_base1 = (c1 <= entry1 and rsi1 < 35 and rvol1 > 1.5) ? "FRESH BUY" : "WAIT"

// Validation Checks
is_atr_valid1 = not na(atr_1) and atr_1 > 0
is_liq_valid1 = tv_1 >= min_tv
is_mono_valid1 = (tp2_1 > tp1_1) and (tp1_1 > entry1) and (entry1 > sl_1)

st1 = not is_atr_valid1 ? "WAIT_ATR" : not is_liq_valid1 ? "WAIT_LIQ" : not is_mono_valid1 ? "WAIT_TICK" : sig_base1

st_c1  = st1 == "FRESH BUY" ? color.lime : st1 == "WAIT_ATR" or st1 == "WAIT_LIQ" or st1 == "WAIT_TICK" ? color.gray : color.gray
rs_c1  = rsi1 < 30 ? color.lime : rsi1 > 70 ? color.red : color.white
rv_c1  = rvol1 > 2 ? color.lime : rvol1 > 1 ? color.yellow : color.gray
