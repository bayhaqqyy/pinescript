// Validation Checks
is_atr_valid7 = not na(atr_7) and atr_7 > 0
is_liq_valid7 = tv_7 >= min_tv
is_mono_valid7 = (tp2_7 > tp1_7) and (tp1_7 > entry7) and (entry7 > sl_7)

