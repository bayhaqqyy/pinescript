    table.cell(tbl, 12, 0, "BANDAR", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 13, 0, "ACTION", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)

