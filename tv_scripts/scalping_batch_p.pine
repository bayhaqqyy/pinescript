act10   = st10 == "FRESH BUY" and bd10 != "NORMAL" ? "HAKA" : (st10 == "RUNNING" or st10 == "PROFIT (>3%)") ? (rsi10 > 80 ? "SELL" : "HOLD") : zona10 == "MAHAL" ? "SKIP" : "WAIT"

st_c10  = st10 == "FRESH BUY" ? color.lime : st10 == "PROFIT (>3%)" ? color.fuchsia : st10 == "RUNNING" ? color.yellow : color.gray
zn_c10  = zona10 == "MURAH" ? color.lime : zona10 == "MAHAL" ? color.red : color.yellow
rs_c10  = rsi10 < 30 ? color.lime : rsi10 > 70 ? color.red : color.white
bd_c10  = bd10 == "BIG ACCUM" ? color.fuchsia : bd10 == "ACCUM" ? color.lime : color.gray
ac_c10  = act10 == "HAKA" ? color.lime : act10 == "SELL" ? color.red : act10 == "HOLD" ? color.yellow : act10 == "SKIP" ? color.red : color.gray
rv_c10  = rvol10 > 2 ? color.lime : rvol10 > 1 ? color.yellow : color.gray

// ============================================================================
// TABLE DISPLAY
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left

var tbl = table.new(tbl_pos, 14, 11, border_width=1, border_color=#333333)

if barstate.islast
    // Header row
    hdr_bg = #ff8c00
    hdr_clr = color.black
    table.cell(tbl, 0, 0, "EMITEN", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
