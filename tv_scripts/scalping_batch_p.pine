// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// Generated on 2026-05-12 | Strategy: SCALPING (Intraday)
//
// @description Scalping screener untuk saham IDX murah (Rp50-500).
//   Default Timeframe: 1 menit. Holding period: menit-jam (intraday).
//   Strategi: Pivot Entry + RSI Oversold (<35) + Volume Spike (RVOL>1.5).
//   Sinyal HAKA = Entry segera saat semua kondisi terpenuhi + ada akumulasi bandar.
//   TP: +3% dari entry | SL: 0.5x ATR di bawah entry.

//@version=6
indicator("SCALPING SCREENER IDX - BATCH P (10 Emiten)", overlay=true, max_bars_back=500)

// ============================================================================
// INPUT
// ============================================================================
tf = input.timeframe("1", "Timeframe Screener")
pos = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// ============================================================================
// TICKER DEFINITIONS (harga per 2026-05-12)
// ============================================================================
tk1 = "IDX:IKAN"  // ~Rp97
tk2 = "IDX:YELO"  // ~Rp95
tk3 = "IDX:ACST"  // ~Rp94
tk4 = "IDX:CARS"  // ~Rp94
tk5 = "IDX:WTON"  // ~Rp88
tk6 = "IDX:GEMA"  // ~Rp87
tk7 = "IDX:TOOL"  // ~Rp87
tk8 = "IDX:LPPS"  // ~Rp85
tk9 = "IDX:EMDE"  // ~Rp80
tk10 = "IDX:LPKR"  // ~Rp80

// ============================================================================
// DATA FETCH - request.security with tuple (1 call per emiten)
// ============================================================================
[c1, h1, l1, v1, o1] = request.security(tk1, tf, [close, high, low, volume, open])
[c2, h2, l2, v2, o2] = request.security(tk2, tf, [close, high, low, volume, open])
[c3, h3, l3, v3, o3] = request.security(tk3, tf, [close, high, low, volume, open])
[c4, h4, l4, v4, o4] = request.security(tk4, tf, [close, high, low, volume, open])
[c5, h5, l5, v5, o5] = request.security(tk5, tf, [close, high, low, volume, open])
[c6, h6, l6, v6, o6] = request.security(tk6, tf, [close, high, low, volume, open])
[c7, h7, l7, v7, o7] = request.security(tk7, tf, [close, high, low, volume, open])
[c8, h8, l8, v8, o8] = request.security(tk8, tf, [close, high, low, volume, open])
[c9, h9, l9, v9, o9] = request.security(tk9, tf, [close, high, low, volume, open])
[c10, h10, l10, v10, o10] = request.security(tk10, tf, [close, high, low, volume, open])

// ============================================================================
// CALCULATIONS
// ============================================================================
// --- IKAN ---
pv1 = (h1[1] + l1[1] + c1[1]) / 3
atr1 = ta.atr(14)
entry1 = math.round(2 * pv1 - h1[1])
tp1    = math.round(entry1 * 1.03)
sl1    = math.round(entry1 - atr1 * 0.5)
pft1   = entry1 > 0 ? (c1 - entry1) / entry1 * 100 : 0
rsi1   = ta.rsi(c1, 14)
avgv1  = ta.sma(v1, 20)
rvol1  = avgv1 > 0 ? v1 / avgv1 : 0
val1   = v1 * c1
bb_b1  = ta.sma(c1, 20)
bb_d1  = 2 * ta.stdev(c1, 20)
zona1  = c1 <= bb_b1 - bb_d1 ? "MURAH" : c1 >= bb_b1 + bb_d1 ? "MAHAL" : "MID"
st1    = c1 <= entry1 and rsi1 < 35 and rvol1 > 1.5 ? "FRESH BUY" : c1 >= tp1 ? "PROFIT (>3%)" : c1 > entry1 ? "RUNNING" : "WAIT"
bd1    = v1 > avgv1 * 3 and c1 >= o1 ? "BIG ACCUM" : v1 > avgv1 * 1.5 and c1 >= o1 ? "ACCUM" : "NORMAL"
act1   = st1 == "FRESH BUY" and bd1 != "NORMAL" ? "HAKA" : (st1 == "RUNNING" or st1 == "PROFIT (>3%)") ? (rsi1 > 80 ? "SELL" : "HOLD") : zona1 == "MAHAL" ? "SKIP" : "WAIT"

st_c1  = st1 == "FRESH BUY" ? color.lime : st1 == "PROFIT (>3%)" ? color.fuchsia : st1 == "RUNNING" ? color.yellow : color.gray
zn_c1  = zona1 == "MURAH" ? color.lime : zona1 == "MAHAL" ? color.red : color.yellow
rs_c1  = rsi1 < 30 ? color.lime : rsi1 > 70 ? color.red : color.white
bd_c1  = bd1 == "BIG ACCUM" ? color.fuchsia : bd1 == "ACCUM" ? color.lime : color.gray
ac_c1  = act1 == "HAKA" ? color.lime : act1 == "SELL" ? color.red : act1 == "HOLD" ? color.yellow : act1 == "SKIP" ? color.red : color.gray
rv_c1  = rvol1 > 2 ? color.lime : rvol1 > 1 ? color.yellow : color.gray
