    table.cell(tbl, 9, row10, str.tostring(rsi10, "#.#"), text_color=rs_c10, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 10, row10, str.tostring(rvol10, "#.##"), text_color=rv_c10, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 11, row10, val10 > 1e9 ? str.tostring(val10/1e9, "#.#") + "B" : str.tostring(val10/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 12, row10, bd10, text_color=color.black, bgcolor=bd_c10, text_size=size.small)
    table.cell(tbl, 13, row10, act10, text_color=color.black, bgcolor=ac_c10, text_size=size.small)

// ============================================================================
// ALERTS - Webhook JSON payload for each HAKA signal
// ============================================================================
if barstate.islast
    if st1 == "FRESH BUY" and act1 == "HAKA"
        alert('{"type":"SCALP","batch":"P","ticker":"IKAN","tf":"' + tf + '","signal":"FRESH_BUY","entry":' + str.tostring(entry1) + ',"tp":' + str.tostring(tp1) + ',"sl":' + str.tostring(sl1) + ',"rsi":' + str.tostring(rsi1, "#.#") + ',"rvol":' + str.tostring(rvol1, "#.##") + ',"zona":"' + zona1 + '","bandar":"' + bd1 + '","action":"HAKA","time":' + str.tostring(time) + '}', alert.freq_once_per_bar)
