// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// Generated on 2026-05-19 | Strategy: BANDAR_AI_V2 (Swing Detection)
//@version=6
indicator("BANDAR AI V2 - BATCH I (6 Emiten)", overlay=true, max_bars_back=500)

// ============================================================================
// INPUT
// ============================================================================
tf             = input.timeframe("60", "Timeframe Screener")
min_tv         = input.float(500000000, "Min Transaction Value per Bar (Rp)")
tp1_mult       = input.float(1.5, "TP1 ATR Multiplier")
tp2_mult       = input.float(3.0, "TP2 ATR Multiplier")
sl_mult        = input.float(1.5, "SL ATR Multiplier")
emaSlowLen     = input.int(200, "EMA Trend")
volMultiplier  = input.float(1.5, "Vol Spike Multiplier")
pos            = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// ============================================================================
// TICKER DEFINITIONS
// ============================================================================
tk1 = "IDX:PEHA"  // BANDAR_SWING
tk2 = "IDX:PYFA"  // BANDAR_SWING
tk3 = "IDX:KKGI"  // BANDAR_SWING
tk4 = "IDX:BIPI"  // BANDAR_SWING
tk5 = "IDX:BUMI"  // BANDAR_SWING
tk6 = "IDX:HUMI"  // BANDAR_SWING

// ============================================================================
// CORE ENGINE FUNCTION
// ============================================================================
f_engine(ema_len, vol_mult) =>
    emaSlow = ta.ema(close, ema_len)
    bullTrend = close > emaSlow
    
    volMA = ta.sma(volume, 20)
    volSpike = volume > volMA * vol_mult
    
    body = math.abs(close - open)
    candleRange = high - low
    lowerWick = math.min(open, close) - low
    
    bullAbsorb = lowerWick > body * 1.1 and volume > volMA * 1.3 and close > low + (candleRange * 0.4)
    sniperBuy = bullTrend and volSpike and (close > open)
    
    status = sniperBuy ? "SNIPER BUY" : bullAbsorb ? "BULL ABSORB" : "WAIT"
    atr_val = ta.atr(14)
    tv_val = volume * close
    [close, status, atr_val, tv_val]

// ============================================================================
// DATA FETCH (request.security)
// ============================================================================
[c1, st_1, atr_1, tv_1] = request.security(tk1, tf, f_engine(emaSlowLen, volMultiplier))
[c2, st_2, atr_2, tv_2] = request.security(tk2, tf, f_engine(emaSlowLen, volMultiplier))
[c3, st_3, atr_3, tv_3] = request.security(tk3, tf, f_engine(emaSlowLen, volMultiplier))
[c4, st_4, atr_4, tv_4] = request.security(tk4, tf, f_engine(emaSlowLen, volMultiplier))
[c5, st_5, atr_5, tv_5] = request.security(tk5, tf, f_engine(emaSlowLen, volMultiplier))
[c6, st_6, atr_6, tv_6] = request.security(tk6, tf, f_engine(emaSlowLen, volMultiplier))

// ============================================================================
// CALCULATIONS
// ============================================================================
// --- PEHA ---
tp1_1 = math.round(c1 + (atr_1 * tp1_mult))
tp2_1 = math.round(c1 + (atr_1 * tp2_mult))
sl_1  = math.round(c1 - (atr_1 * sl_mult))

// --- PYFA ---
tp1_2 = math.round(c2 + (atr_2 * tp1_mult))
tp2_2 = math.round(c2 + (atr_2 * tp2_mult))
sl_2  = math.round(c2 - (atr_2 * sl_mult))

// --- KKGI ---
tp1_3 = math.round(c3 + (atr_3 * tp1_mult))
tp2_3 = math.round(c3 + (atr_3 * tp2_mult))
sl_3  = math.round(c3 - (atr_3 * sl_mult))

// --- BIPI ---
tp1_4 = math.round(c4 + (atr_4 * tp1_mult))
tp2_4 = math.round(c4 + (atr_4 * tp2_mult))
sl_4  = math.round(c4 - (atr_4 * sl_mult))

// --- BUMI ---
tp1_5 = math.round(c5 + (atr_5 * tp1_mult))
tp2_5 = math.round(c5 + (atr_5 * tp2_mult))
sl_5  = math.round(c5 - (atr_5 * sl_mult))

// --- HUMI ---
tp1_6 = math.round(c6 + (atr_6 * tp1_mult))
tp2_6 = math.round(c6 + (atr_6 * tp2_mult))
sl_6  = math.round(c6 - (atr_6 * sl_mult))


// ============================================================================
// TABLE DISPLAY
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left
var tbl = table.new(tbl_pos, 4, 7, border_width=1, border_color=#333333)

f_get_color(st) =>
    st == "SNIPER BUY" ? color.lime : st == "BULL ABSORB" ? color.aqua : color.gray

if barstate.islast
    // Header
    hdr_bg = #6a0dad
    hdr_clr = color.white
    table.cell(tbl, 0, 0, "EMITEN", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 1, 0, "PRICE", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 2, 0, "DOLVOL", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    table.cell(tbl, 3, 0, "SIGNAL", text_color=hdr_clr, bgcolor=hdr_bg, text_size=size.small)
    
    table.cell(tbl, 0, 1, "PEHA", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(c1, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 1, str.tostring(tv_1/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, 1, st_1, text_color=color.black, bgcolor=f_get_color(st_1), text_size=size.small)
    table.cell(tbl, 0, 2, "PYFA", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(c2, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 2, str.tostring(tv_2/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, 2, st_2, text_color=color.black, bgcolor=f_get_color(st_2), text_size=size.small)
    table.cell(tbl, 0, 3, "KKGI", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(c3, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 3, str.tostring(tv_3/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, 3, st_3, text_color=color.black, bgcolor=f_get_color(st_3), text_size=size.small)
    table.cell(tbl, 0, 4, "BIPI", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(c4, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 4, str.tostring(tv_4/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, 4, st_4, text_color=color.black, bgcolor=f_get_color(st_4), text_size=size.small)
    table.cell(tbl, 0, 5, "BUMI", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(c5, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 5, str.tostring(tv_5/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, 5, st_5, text_color=color.black, bgcolor=f_get_color(st_5), text_size=size.small)
    table.cell(tbl, 0, 6, "HUMI", text_color=color.yellow, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(c6, "#"), text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 2, 6, str.tostring(tv_6/1e6, "#.#") + "M", text_color=color.white, bgcolor=#1a1a2e, text_size=size.small)
    table.cell(tbl, 3, 6, st_6, text_color=color.black, bgcolor=f_get_color(st_6), text_size=size.small)

// ============================================================================
// ALERTS UNTUK TELEGRAM (JSON PAYLOAD)
// ============================================================================
if barstate.islast and barstate.isconfirmed
    if (st_1 == "SNIPER BUY" or st_1 == "BULL ABSORB") and tv_1 >= min_tv
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"PEHA","tf":"' + tf + '","signal":"' + st_1 + '","entry":' + str.tostring(c1) + ',"tp1":' + str.tostring(tp1_1) + ',"tp2":' + str.tostring(tp2_1) + ',"sl":' + str.tostring(sl_1) + ',"holding_hint":"swing 3-7 hari","time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if (st_2 == "SNIPER BUY" or st_2 == "BULL ABSORB") and tv_2 >= min_tv
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"PYFA","tf":"' + tf + '","signal":"' + st_2 + '","entry":' + str.tostring(c2) + ',"tp1":' + str.tostring(tp1_2) + ',"tp2":' + str.tostring(tp2_2) + ',"sl":' + str.tostring(sl_2) + ',"holding_hint":"swing 3-7 hari","time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if (st_3 == "SNIPER BUY" or st_3 == "BULL ABSORB") and tv_3 >= min_tv
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"KKGI","tf":"' + tf + '","signal":"' + st_3 + '","entry":' + str.tostring(c3) + ',"tp1":' + str.tostring(tp1_3) + ',"tp2":' + str.tostring(tp2_3) + ',"sl":' + str.tostring(sl_3) + ',"holding_hint":"swing 3-7 hari","time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if (st_4 == "SNIPER BUY" or st_4 == "BULL ABSORB") and tv_4 >= min_tv
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"BIPI","tf":"' + tf + '","signal":"' + st_4 + '","entry":' + str.tostring(c4) + ',"tp1":' + str.tostring(tp1_4) + ',"tp2":' + str.tostring(tp2_4) + ',"sl":' + str.tostring(sl_4) + ',"holding_hint":"swing 3-7 hari","time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if (st_5 == "SNIPER BUY" or st_5 == "BULL ABSORB") and tv_5 >= min_tv
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"BUMI","tf":"' + tf + '","signal":"' + st_5 + '","entry":' + str.tostring(c5) + ',"tp1":' + str.tostring(tp1_5) + ',"tp2":' + str.tostring(tp2_5) + ',"sl":' + str.tostring(sl_5) + ',"holding_hint":"swing 3-7 hari","time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    if (st_6 == "SNIPER BUY" or st_6 == "BULL ABSORB") and tv_6 >= min_tv
        alert('{"type":"BANDAR_AI","tier":"BANDAR_SWING","ticker":"HUMI","tf":"' + tf + '","signal":"' + st_6 + '","entry":' + str.tostring(c6) + ',"tp1":' + str.tostring(tp1_6) + ',"tp2":' + str.tostring(tp2_6) + ',"sl":' + str.tostring(sl_6) + ',"holding_hint":"swing 3-7 hari","time":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)

plot(close, display=display.none)
