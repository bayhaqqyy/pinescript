bandarFlag8 = math.floor((packedFlags8 / 100) % 10)
macdFlag8   = math.floor((packedFlags8 / 1000) % 10)
statusFlag8 = math.floor((packedFlags8 / 10000) % 10)

// Decode flags locally
statusRaw8 = statusFlag8 == 1.0 ? "SL-BROKE" : statusFlag8 == 2.0 ? "TP-HIT" : statusFlag8 == 3.0 ? "FLYING" : statusFlag8 == 4.0 ? "SETUP" : statusFlag8 == 5.0 ? "RUNNING" : "WAIT"
macd8 = macdFlag8 == 1.0 ? "UP" : "DOWN"
bandar8 = bandarFlag8 == 1.0 ? "BIG ACCUM" : bandarFlag8 == 2.0 ? "ACCUM" : bandarFlag8 == 3.0 ? "DIST AWAL" : bandarFlag8 == 4.0 ? "SEPI" : "NORMAL"
action8 = actionFlag8 == 1.0 ? "WASPADA" : actionFlag8 == 2.0 ? "BUY" : "WAIT"
signal8 = signalFlag8 == 1.0 ? "DIST-AWAL" : signalFlag8 == 2.0 ? "AKUMULASI" : signalFlag8 == 3.0 ? "BOW-SIAP" : signalFlag8 == 4.0 ? "SETUP-OK" : signalFlag8 == 5.0 ? "NETRAL" : "WEAK"

// Calculate zona locally on-chart to save memory
rangeSr8 = math.max(rst8 - sup8, syminfo.mintick)
rangePos8 = (now8 - sup8) / rangeSr8
zona8 = rangePos8 <= 0.382 ? "MURAH" : rangePos8 <= 0.618 ? "MID" : "MAHAL"

// State Machine logic
longTpHit8 = activeSide8 == "BUY" and hi8 >= activeTp1_8
longTp2Hit8 = activeSide8 == "BUY" and hi8 >= activeTp2_8
longSlHit8 = activeSide8 == "BUY" and lo8 <= activeSl8

bothHitLong8 = longTpHit8 and longSlHit8
if bothHitLong8
    if sameBarRule == "SL_FIRST"
        longTpHit8 := false
        longTp2Hit8 := false
    else if sameBarRule == "TP_FIRST"
        longSlHit8 := false
    else if sameBarRule == "IGNORE"
        longTpHit8 := false
        longTp2Hit8 := false
        longSlHit8 := false

// Only trigger entry on qualified signals
entryAllowed8 = action8 == "BUY" and (signal8 == "AKUMULASI" or signal8 == "BOW-SIAP" or signal8 == "SETUP-OK")
entryEvent8 = activeSide8 == "" and entryAllowed8 ? "BUY_ENTRY" : "NONE"
event8 = (activeSide8 == "BUY" and longSlHit8) ? "SL_HIT" : (activeSide8 == "BUY" and longTp2Hit8) ? "TP2_HIT" : (activeSide8 == "BUY" and longTpHit8) ? "TP1_HIT" : entryEvent8

alertSide8 = event8 == "BUY_ENTRY" ? "BUY" : activeSide8
alertEntry8 = event8 == "BUY_ENTRY" ? entry8 : activeEntry8
alertTp1_8 = event8 == "BUY_ENTRY" ? tp1_8 : activeTp1_8
alertTp2_8 = event8 == "BUY_ENTRY" ? tp2_8 : activeTp2_8
alertSl8 = event8 == "BUY_ENTRY" ? sl_8 : activeSl8

if event8 == "SL_HIT" or event8 == "TP1_HIT" or event8 == "TP2_HIT"
    activeSide8 := ""
    activeEntry8 := na
    activeTp1_8 := na
    activeTp2_8 := na
    activeSl8 := na
    activeMode8 := na
else if event8 == "BUY_ENTRY"
    activeSide8 := "BUY"
    activeEntry8 := entry8
    activeTp1_8 := tp1_8
    activeTp2_8 := tp2_8
    activeSl8 := sl_8
    activeMode8 := signalFlag8

sendAlert8 = event8 == "BUY_ENTRY" or event8 == "TP1_HIT" or event8 == "TP2_HIT" or event8 == "SL_HIT"
canAlert8 = sendAlert8 and (event8 != lastEvent8 or na(lastBar8) or bar_index - lastBar8 >= cooldownBars)

alertModeRaw8 = event8 == "BUY_ENTRY" ? signalFlag8 : activeMode8
alertMode8 = alertModeRaw8 == 1.0 ? "DIST-AWAL" : alertModeRaw8 == 2.0 ? "AKUMULASI" : alertModeRaw8 == 3.0 ? "BOW-SIAP" : alertModeRaw8 == 4.0 ? "SETUP-OK" : "NONE"

// Display values - locked if position is active, else dynamic
entryDisp8 = na(activeEntry8) ? entry8 : activeEntry8
tp1Disp8 = na(activeTp1_8) ? tp1_8 : activeTp1_8
tp2Disp8 = na(activeTp2_8) ? tp2_8 : activeTp2_8
slDisp8 = na(activeSl8) ? sl_8 : activeSl8

pctTp1_8 = entryDisp8 > 0 ? ((tp1Disp8 - entryDisp8) / entryDisp8) * 100.0 : na
pctTp2_8 = entryDisp8 > 0 ? ((tp2Disp8 - entryDisp8) / entryDisp8) * 100.0 : na
pnlPct8 = activeSide8 == "BUY" ? ((now8 - activeEntry8) / activeEntry8) * 100.0 : na

// Override status for active trades
status8 = activeSide8 == "BUY" ? "RUNNING" : (event8 == "TP1_HIT" or event8 == "TP2_HIT") ? "TP-HIT" : event8 == "SL_HIT" ? "SL-BROKE" : statusRaw8


// ============================================================================
// TABLE DISPLAY
// ============================================================================
tbl_pos = pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left
var tbl = table.new(tbl_pos, 22, 9, border_width=1, border_color=#333333)

if barstate.islast
    f_header(tbl, 0, "EMITEN")
    f_header(tbl, 1, "TF")
    f_header(tbl, 2, "SUP")
    f_header(tbl, 3, "RST")
    f_header(tbl, 4, "ENTRY")
    f_header(tbl, 5, "NOW")
    f_header(tbl, 6, "TP1")
    f_header(tbl, 7, "TP2")
    f_header(tbl, 8, "SL")
    f_header(tbl, 9, "PnL%")
    f_header(tbl, 10, "%TP1")
    f_header(tbl, 11, "%TP2")
    f_header(tbl, 12, "STATUS")
    f_header(tbl, 13, "ZONA")
    f_header(tbl, 14, "RSI")
    f_header(tbl, 15, "MACD")
    f_header(tbl, 16, "RVOL")
    f_header(tbl, 17, "VALUE")
    f_header(tbl, 18, "FLOW")
    f_header(tbl, 19, "ACTION")
    f_header(tbl, 20, "SCORE")
    f_header(tbl, 21, "SINYAL")
    // Row 1
    pnlDisp1 = na(pnlPct1) ? "-" : (pnlPct1 >= 0.0 ? "+" : "") + str.tostring(pnlPct1, "#.##") + "%"
    pnlBg1 = na(pnlPct1) ? cDark : (pnlPct1 >= 0.0 ? cGreen : cRed)
    entryValDisp1 = na(entryDisp1) ? "-" : str.tostring(entryDisp1, "#")
    tp1ValDisp1 = na(tp1Disp1) ? "-" : str.tostring(tp1Disp1, "#")
    tp2ValDisp1 = na(tp2Disp1) ? "-" : str.tostring(tp2Disp1, "#")
    slValDisp1 = na(slDisp1) ? "-" : str.tostring(slDisp1, "#")
    
    f_cell(tbl, 0, 1, "PEHA", color.rgb(30, 90, 180), color.white)
    f_cell(tbl, 1, 1, tf, cDark, color.white)
    f_cell(tbl, 2, 1, str.tostring(sup1, "#"), cDark, color.white)
    f_cell(tbl, 3, 1, str.tostring(rst1, "#"), cDark, color.white)
