statusFlag3 = math.floor((packedFlags3 / 10000) % 10)

// Decode flags locally
statusRaw3 = statusFlag3 == 1.0 ? "SL-BROKE" : statusFlag3 == 2.0 ? "TP-HIT" : statusFlag3 == 3.0 ? "FLYING" : statusFlag3 == 4.0 ? "SETUP" : statusFlag3 == 5.0 ? "RUNNING" : "WAIT"
macd3 = macdFlag3 == 1.0 ? "UP" : "DOWN"
bandar3 = bandarFlag3 == 1.0 ? "BIG ACCUM" : bandarFlag3 == 2.0 ? "ACCUM" : bandarFlag3 == 3.0 ? "DIST AWAL" : bandarFlag3 == 4.0 ? "SEPI" : "NORMAL"
action3 = actionFlag3 == 1.0 ? "WASPADA" : actionFlag3 == 2.0 ? "BUY" : "WAIT"
signal3 = signalFlag3 == 1.0 ? "DIST-AWAL" : signalFlag3 == 2.0 ? "AKUMULASI" : signalFlag3 == 3.0 ? "BOW-SIAP" : signalFlag3 == 4.0 ? "SETUP-OK" : signalFlag3 == 5.0 ? "NETRAL" : "WEAK"

// Calculate zona locally on-chart to save memory
rangeSr3 = math.max(rst3 - sup3, syminfo.mintick)
rangePos3 = (now3 - sup3) / rangeSr3
zona3 = rangePos3 <= 0.382 ? "MURAH" : rangePos3 <= 0.618 ? "MID" : "MAHAL"

// State Machine logic
longTpHit3 = activeSide3 == "BUY" and hi3 >= activeTp1_3
longTp2Hit3 = activeSide3 == "BUY" and hi3 >= activeTp2_3
longSlHit3 = activeSide3 == "BUY" and lo3 <= activeSl3

bothHitLong3 = longTpHit3 and longSlHit3
if bothHitLong3
    if sameBarRule == "SL_FIRST"
        longTpHit3 := false
        longTp2Hit3 := false
    else if sameBarRule == "TP_FIRST"
        longSlHit3 := false
    else if sameBarRule == "IGNORE"
        longTpHit3 := false
        longTp2Hit3 := false
        longSlHit3 := false

// Only trigger entry on qualified signals
entryAllowed3 = action3 == "BUY" and (signal3 == "AKUMULASI" or signal3 == "BOW-SIAP" or signal3 == "SETUP-OK")
entryEvent3 = activeSide3 == "" and entryAllowed3 ? "BUY_ENTRY" : "NONE"
event3 = (activeSide3 == "BUY" and longSlHit3) ? "SL_HIT" : (activeSide3 == "BUY" and longTp2Hit3) ? "TP2_HIT" : (activeSide3 == "BUY" and longTpHit3) ? "TP1_HIT" : entryEvent3

alertSide3 = event3 == "BUY_ENTRY" ? "BUY" : activeSide3
