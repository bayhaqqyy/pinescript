//@version=6
indicator("Gold Futures Autobot V3 (XAUUSDT)", overlay=true, max_bars_back=200)

// ============================================================================
// INPUTS & SETTINGS
// ============================================================================
tf = input.timeframe("15", "Timeframe")
srLen = input.int(14, "S/R lookback length", minval=5)
atrLen = input.int(14, "ATR Length", minval=5)
leverage = input.int(20, "Leverage", minval=1, maxval=125)

entryScore = input.int(65, "Minimum Entry Score", minval=10, maxval=100)
scoreGap = input.int(6, "Long/Short Score Gap", minval=1, maxval=20)

slAtrMult = input.float(1.4, "SL ATR Mult (Gold Optimized)", step=0.1)
tpAtrMult = input.float(2.4, "TP ATR Mult (Gold Optimized)", step=0.1)
minRR = input.float(1.6, "Minimum Risk:Reward Ratio", step=0.1)

minSlRawPct = input.float(0.6, "Minimum SL %", step=0.05)
minTpRawPct = input.float(1.0, "Minimum TP %", step=0.05)
maxPlanRiskPct = input.float(2.0, "Max Raw Risk % Allowed", step=0.1)
maxLevRiskPct = input.float(25.0, "Max Leveraged Risk % Allowed", step=5.0)

breakoutBufferPct = input.float(0.04, "Breakout Buffer %", step=0.01)
srAtrBuffer = input.float(0.15, "S/R ATR Buffer", step=0.05)
useStructureSL = input.bool(true, "Use S/R Structure for SL")
maxStructureRiskPct = input.float(2.5, "Max Structure Risk %", step=0.1)

cooldownBars = input.int(3, "Alert Cooldown Bars", minval=1)

sameBarRule = input.string("SL_FIRST", "Same Bar TP/SL Rule", options=["SL_FIRST", "TP_FIRST", "IGNORE"])
useTrendEntry = input.bool(true, "Use Trend-Following Entry")
usePullbackEntry = input.bool(true, "Use Pullback Entry")
useBreakoutEntry = input.bool(false, "Use Breakout Entry")
useReversalEntry = input.bool(true, "Use Reversal As Entry (Buy Bottom/Sell Top)")
useSRDistanceCheck = input.bool(true, "Enable Distance-from-S/R Check")
srDistanceThresholdPct = input.float(0.5, "Max Distance from S/R (%)", minval=0.01, maxval=5.0, step=0.05)

// ============================================================================
// CORE INDICATORS (7-LAYER ENGINE)
// ============================================================================
sup = ta.lowest(low[1], srLen)
rst = ta.highest(high[1], srLen)
atrVal = ta.atr(atrLen)
rsiVal = ta.rsi(close, 14)
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)

emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
ema200  = ta.ema(close, 200)

volMA = ta.sma(volume, 20)
rvol = volMA > 0 ? volume / volMA : 1.0
volOk = rvol >= 1.0

// Candle Behavior & Wick Rejection
body = math.abs(close - open)
barRange = math.max(high - low, syminfo.mintick)
greenCandle = close > open
redCandle = close < open
closeNearHigh = barRange > 0 and close >= low + barRange * 0.65
closeNearLow  = barRange > 0 and close <= low + barRange * 0.35

upperReject = body > 0 and (high - math.max(open, close)) >= body * 0.8
lowerReject = body > 0 and (math.min(open, close) - low) >= body * 0.8

// Trend & Momentum Bias
trendLong = close > emaFast and emaFast > emaSlow and close > ema200
trendShort = close < emaFast and emaFast < emaSlow and close < ema200
momentumLong = rsiVal >= 45 and rsiVal <= 65 and hist > 0 and hist >= hist[1]
momentumShort = rsiVal <= 55 and rsiVal >= 38 and hist < 0 and hist <= hist[1]

// Late entry guard: jangan masuk jika RSI sudah hampir extreme
lateForLong = rsiVal > 62
lateForShort = rsiVal < 40

overheat = rsiVal > 65 or close > emaFast + atrVal * 1.5
oversold = rsiVal < 35 or close < emaFast - atrVal * 1.5

bullishImpulse = greenCandle and closeNearHigh and close > close[1]
bearishImpulse = redCandle and closeNearLow and close < close[1]

// Triggers
buf = breakoutBufferPct / 100.0
longTrigger = rst * (1 + buf)
shortTrigger = sup * (1 - buf)

longBreak = close >= longTrigger
shortBreak = close <= shortTrigger

entryLong = close
entryShort = close

// Distance check: harga harus masih dekat/belum jauh dari S/R
distFromRstPct = rst > 0 ? (rst - close) / rst * 100.0 : 0.0
distFromSupPct = sup > 0 ? (close - sup) / sup * 100.0 : 0.0

nearOptimalLong = not useSRDistanceCheck or (distFromSupPct <= srDistanceThresholdPct)
nearOptimalShort = not useSRDistanceCheck or (distFromRstPct <= srDistanceThresholdPct)

// ============================================================================
// RISK & SYSTEMATIC TRADE PLANNING
// ============================================================================
// Stop Loss Long
baseSlLongDist = math.max(atrVal * slAtrMult, entryLong * minSlRawPct / 100.0, syminfo.mintick)
structSlLong = sup - atrVal * srAtrBuffer
structSlLongDist = entryLong - structSlLong
structRiskLongPct = entryLong > 0 ? (structSlLongDist / entryLong) * 100.0 : na
useStructLong = useStructureSL and not na(structSlLongDist) and structSlLongDist > 0 and structRiskLongPct <= maxStructureRiskPct
slLongDist = useStructLong ? math.max(baseSlLongDist, structSlLongDist) : baseSlLongDist
slLong = entryLong - slLongDist

// Stop Loss Short
baseSlShortDist = math.max(atrVal * slAtrMult, entryShort * minSlRawPct / 100.0, syminfo.mintick)
structSlShort = rst + atrVal * srAtrBuffer
structSlShortDist = structSlShort - entryShort
structRiskShortPct = entryShort > 0 ? (structSlShortDist / entryShort) * 100.0 : na
useStructShort = useStructureSL and not na(structSlShortDist) and structSlShortDist > 0 and structRiskShortPct <= maxStructureRiskPct
slShortDist = useStructShort ? math.max(baseSlShortDist, structSlShortDist) : baseSlShortDist
slShort = entryShort + slShortDist

// Take Profit Long
tpLongByAtrDist = atrVal * tpAtrMult
tpLongByMinPctDist = entryLong * minTpRawPct / 100.0
tpLongByRRDist = slLongDist * minRR
tpLongDist = math.max(tpLongByAtrDist, tpLongByMinPctDist, tpLongByRRDist)
tpLong = entryLong + tpLongDist

// Take Profit Short
tpShortByAtrDist = atrVal * tpAtrMult
tpShortByMinPctDist = entryShort * minTpRawPct / 100.0
tpShortByRRDist = slShortDist * minRR
tpShortDist = math.max(tpShortByAtrDist, tpShortByMinPctDist, tpShortByRRDist)
tpShort = math.max(entryShort - tpShortDist, 0.00000001)

// Direction and Risk Validation
dirOkLong = tpLong > entryLong and slLong < entryLong
dirOkShort = tpShort < entryShort and slShort > entryShort

riskPctLong = entryLong > 0 ? (slLongDist / entryLong) * 100.0 : na
riskPctShort = entryShort > 0 ? (slShortDist / entryShort) * 100.0 : na

riskOkLong = not na(riskPctLong) and riskPctLong <= maxPlanRiskPct and (riskPctLong * leverage) <= maxLevRiskPct and (slLongDist > 0 ? tpLongDist / slLongDist : 0) >= minRR
riskOkShort = not na(riskPctShort) and riskPctShort <= maxPlanRiskPct and (riskPctShort * leverage) <= maxLevRiskPct and (slShortDist > 0 ? tpShortDist / slShortDist : 0) >= minRR

// Layer 6 - Actions
// Pullback Entry
nearEmaLong = low <= emaFast + atrVal * 0.25 and close > emaFast
nearEmaShort = high >= emaFast - atrVal * 0.25 and close < emaFast

longPullbackAction = trendLong and nearEmaLong and greenCandle and closeNearHigh and hist > hist[1] and rsiVal > 43 and volOk
shortPullbackAction = trendShort and nearEmaShort and redCandle and closeNearLow and hist < hist[1] and rsiVal < 57 and volOk

longTrendAction = trendLong and momentumLong and volOk and greenCandle and closeNearHigh and not overheat
shortTrendAction = trendShort and momentumShort and volOk and redCandle and closeNearLow and not oversold

longBreakoutAction = longBreak and greenCandle and closeNearHigh and volOk
shortBreakdownAction = shortBreak and redCandle and closeNearLow and volOk

longReversalAction = useReversalEntry and oversold and lowerReject and greenCandle and closeNearHigh and rvol >= 1.2 and hist > hist[1]
shortReversalAction = useReversalEntry and overheat and upperReject and redCandle and closeNearLow and rvol >= 1.2 and hist < hist[1]

validLongAction = ((useTrendEntry and longTrendAction) or (usePullbackEntry and longPullbackAction) or (useBreakoutEntry and longBreakoutAction) or (useReversalEntry and longReversalAction)) and riskOkLong and dirOkLong and not lateForLong and nearOptimalLong
validShortAction = ((useTrendEntry and shortTrendAction) or (usePullbackEntry and shortPullbackAction) or (useBreakoutEntry and shortBreakdownAction) or (useReversalEntry and shortReversalAction)) and riskOkShort and dirOkShort and not lateForShort and nearOptimalShort

if bullishImpulse
    validShortAction := false
if bearishImpulse
    validLongAction := false

// Layer 7 - Institutional Flow & Scoring
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
longAbsorb  = lowerWick > body * 1.2 and closeNearHigh and rvol >= 1.3
shortAbsorb = upperWick > body * 1.2 and closeNearLow and rvol >= 1.3
smallBodyHighVol = body <= atrVal * 0.30 and rvol >= 1.8

flow = bullishImpulse and trendLong ? "LONG FLOW" : bearishImpulse and trendShort ? "SHORT FLOW" : longAbsorb ? "BUY ABSORB" : shortAbsorb ? "SELL ABSORB" : smallBodyHighVol ? "SQUEEZE" : rvol < 0.5 ? "SEPI" : "NORMAL"

longFlow = flow == "LONG FLOW" or flow == "BUY ABSORB"
shortFlow = flow == "SHORT FLOW" or flow == "SELL ABSORB"

flowConflict = (validShortAction and longFlow) or (validLongAction and shortFlow)
if flowConflict
    validLongAction := false
    validShortAction := false

scoreLong = 0.0
scoreLong += trendLong ? 20.0 : 0.0
scoreLong += momentumLong ? 20.0 : 0.0
scoreLong += volOk ? 15.0 : 0.0
scoreLong += greenCandle ? 15.0 : 0.0
scoreLong += closeNearHigh ? 10.0 : 0.0
scoreLong += longFlow ? 10.0 : 0.0
scoreLong += not overheat ? 10.0 : 0.0
scoreLong += nearOptimalLong ? 10.0 : 0.0
scoreLong := math.min(scoreLong, 100.0)

scoreShort = 0.0
scoreShort += trendShort ? 20.0 : 0.0
scoreShort += momentumShort ? 20.0 : 0.0
scoreShort += volOk ? 15.0 : 0.0
scoreShort += redCandle ? 15.0 : 0.0
scoreShort += closeNearLow ? 10.0 : 0.0
scoreShort += shortFlow ? 10.0 : 0.0
scoreShort += not oversold ? 10.0 : 0.0
scoreShort += nearOptimalShort ? 10.0 : 0.0
scoreShort := math.min(scoreShort, 100.0)

longScoreOk = scoreLong >= entryScore and scoreLong > scoreShort + scoreGap
shortScoreOk = scoreShort >= entryScore and scoreShort > scoreLong + scoreGap

action = validLongAction and longScoreOk ? "LONG" : validShortAction and shortScoreOk ? "SHORT" : "WAIT"

modeFlag = (longTrendAction or shortTrendAction) ? 1.0 : (longPullbackAction or shortPullbackAction) ? 2.0 : (longBreakoutAction or shortBreakdownAction) ? 3.0 : (longReversalAction or shortReversalAction) ? 4.0 : 0.0

// Round values
f_round_tick(x) => math.round(x / syminfo.mintick) * syminfo.mintick
f_safe_fmt(val) => na(val) ? "null" : str.tostring(val, "0.00")
f_safe_str(val) => na(val) ? "null" : str.tostring(val)

finalEntry = action == "LONG" ? f_round_tick(close) : action == "SHORT" ? f_round_tick(close) : na
finalTP = action == "LONG" ? f_round_tick(tpLong) : action == "SHORT" ? f_round_tick(tpShort) : na
finalSL = action == "LONG" ? f_round_tick(slLong) : action == "SHORT" ? f_round_tick(slShort) : na

// ============================================================================
// DYNAMIC TRADE STATE MACHINE & WEBHOOK
// ============================================================================
var string activeSide = ""
var float activeEntry = na
var float activeTp = na
var float activeSl = na
var string lastEvent = ""
var int lastBar = na
var float activeMode = na

longTpHit = activeSide == "LONG" and high >= activeTp
longSlHit = activeSide == "LONG" and low <= activeSl
shortTpHit = activeSide == "SHORT" and low <= activeTp
shortSlHit = activeSide == "SHORT" and high >= activeSl

bothHitLong = longTpHit and longSlHit
bothHitShort = shortTpHit and shortSlHit

if bothHitLong
    if sameBarRule == "SL_FIRST"
        longTpHit := false
    else if sameBarRule == "TP_FIRST"
        longSlHit := false
    else if sameBarRule == "IGNORE"
        longTpHit := false
        longSlHit := false

if bothHitShort
    if sameBarRule == "SL_FIRST"
        shortTpHit := false
    else if sameBarRule == "TP_FIRST"
        shortSlHit := false
    else if sameBarRule == "IGNORE"
        shortTpHit := false
        shortSlHit := false

entryEvent = activeSide == "" and action == "LONG" ? "LONG_ENTRY" : activeSide == "" and action == "SHORT" ? "SHORT_ENTRY" : "NONE"
event = (activeSide == "LONG" and longTpHit) ? "LONG_TP_HIT" : (activeSide == "LONG" and longSlHit) ? "LONG_SL_HIT" : (activeSide == "SHORT" and shortTpHit) ? "SHORT_TP_HIT" : (activeSide == "SHORT" and shortSlHit) ? "SHORT_SL_HIT" : entryEvent

alertSide = event == "LONG_ENTRY" ? "LONG" : event == "SHORT_ENTRY" ? "SHORT" : activeSide
alertEntry = event == "LONG_ENTRY" or event == "SHORT_ENTRY" ? finalEntry : activeEntry
alertTp = event == "LONG_ENTRY" or event == "SHORT_ENTRY" ? finalTP : activeTp
alertSl = event == "LONG_ENTRY" or event == "SHORT_ENTRY" ? finalSL : activeSl

// Compute derivative metrics from display/alert values
dispEntry = not na(alertEntry) ? alertEntry : finalEntry
dispTP = not na(alertTp) ? alertTp : finalTP
dispSL = not na(alertSl) ? alertSl : finalSL

riskPct = not na(dispEntry) and dispEntry > 0 ? math.abs(dispEntry - dispSL) / dispEntry * 100.0 : na
tpPct = not na(dispEntry) and dispEntry > 0 ? math.abs(dispTP - dispEntry) / dispEntry * 100.0 : na
rr = not na(riskPct) and riskPct > 0 ? tpPct / riskPct : na
levRiskPct = riskPct * leverage
levTpPct = tpPct * leverage

score = action == "LONG" ? scoreLong : action == "SHORT" ? scoreShort : math.max(scoreLong, scoreShort)
riskLabel = na(levRiskPct) ? "NO_DATA" : levRiskPct <= 35 ? "SAFE" : levRiskPct <= 65 ? "RISKY" : "HIGH"

// Max safe leverage
maxSafeLeverage = not na(riskPct) and riskPct > 0 ? math.floor(20.0 / riskPct) : 20

// Liq warn
liqPriceLong = dispEntry * (1 - 0.90 / leverage)
liqPriceShort = dispEntry * (1 + 0.90 / leverage)
liqWarnLong = dispSL <= liqPriceLong ? "HIGH RISK" : dispSL <= liqPriceLong * 1.02 ? "WARNING" : "SAFE"
liqWarnShort = dispSL >= liqPriceShort ? "HIGH RISK" : dispSL >= liqPriceShort * 0.98 ? "WARNING" : "SAFE"
sideForRisk = activeSide != "" ? activeSide : action
liqWarn = sideForRisk == "LONG" ? liqWarnLong : sideForRisk == "SHORT" ? liqWarnShort : "SAFE"

if event == "LONG_SL_HIT" or event == "LONG_TP_HIT" or event == "SHORT_SL_HIT" or event == "SHORT_TP_HIT"
    activeSide := ""
    activeEntry := na
    activeTp := na
    activeSl := na
    activeMode := na
else if event == "LONG_ENTRY"
    activeSide := "LONG"
    activeEntry := finalEntry
    activeTp := finalTP
    activeSl := finalSL
    activeMode := modeFlag
else if event == "SHORT_ENTRY"
    activeSide := "SHORT"
    activeEntry := finalEntry
    activeTp := finalTP
    activeSl := finalSL
    activeMode := modeFlag

sendAlert = event == "LONG_ENTRY" or event == "SHORT_ENTRY" or event == "LONG_TP_HIT" or event == "LONG_SL_HIT" or event == "SHORT_TP_HIT" or event == "SHORT_SL_HIT"
canAlert = sendAlert and (event != lastEvent or na(lastBar) or bar_index - lastBar >= cooldownBars)

alertModeRaw = event == "LONG_ENTRY" or event == "SHORT_ENTRY" ? modeFlag : activeMode
alertMode = alertModeRaw == 1.0 ? "TREND_SCALP" : alertModeRaw == 2.0 ? "PULLBACK_SCALP" : alertModeRaw == 3.0 ? "BREAKOUT_SCALP" : alertModeRaw == 4.0 ? "REVERSAL_ENTRY" : "NONE"

alertTpPct = na(tpPct) ? 0.0 : tpPct
alertRiskPct = na(riskPct) ? 0.0 : riskPct
alertRr = na(rr) ? 0.0 : rr
alertLevTp = na(levTpPct) ? 0.0 : levTpPct
alertLevRisk = na(levRiskPct) ? 0.0 : levRiskPct

if barstate.isconfirmed and canAlert
    msg = '{"market": "BINANCE_FUTURES", "type": "FUTURES_SIGNAL", "event": "' + event + '", "side": "' + str.tostring(alertSide) + '", "symbol": "XAUUSDT", "tf": "15", "now": ' + str.tostring(close) + ', "entry": ' + f_safe_str(alertEntry) + ', "tp": ' + f_safe_str(alertTp) + ', "sl": ' + f_safe_str(alertSl) + ', "tp_pct": ' + str.tostring(alertTpPct) + ', "risk_pct": ' + str.tostring(alertRiskPct) + ', "rr": ' + str.tostring(alertRr) + ', "leverage": ' + str.tostring(leverage) + ', "lev_tp_pct": ' + str.tostring(alertLevTp) + ', "lev_risk_pct": ' + str.tostring(alertLevRisk) + ', "risk_label": "' + riskLabel + '", "liq_warn": "' + liqWarn + '", "bb_squeeze": "NORMAL", "max_safe_leverage": ' + str.tostring(maxSafeLeverage) + ', "score": ' + str.tostring(score) + ', "flow": "' + flow + '", "signal": "' + action + '", "mode": "' + alertMode + '", "price_text": {"now": "' + f_safe_fmt(close) + '", "entry": "' + f_safe_fmt(alertEntry) + '", "tp": "' + f_safe_fmt(alertTp) + '", "sl": "' + f_safe_fmt(alertSl) + '"}, "tick_size": 0.01, "price_decimals": 2, "time": ' + str.tostring(time) + '}'
    alert(msg, alert.freq_once_per_bar_close)
    lastEvent := event
    lastBar := bar_index

// ============================================================================
// VISUAL PLOTTING & OVERLAYS
// ============================================================================
// EMAs
plot(emaFast, "EMA 20 (Fast)", color=color.orange, linewidth=1)
plot(emaSlow, "EMA 50 (Slow)", color=color.blue, linewidth=1)
plot(ema200, "EMA 200 (Major Trend)", color=color.purple, linewidth=2)

// Active Trade levels
plot(activeSide != "" ? activeEntry : na, "Active Entry", color=color.aqua, style=plot.style_linebr)
plot(activeSide != "" ? activeTp : na, "Active TP", color=color.lime, style=plot.style_linebr)
plot(activeSide != "" ? activeSl : na, "Active SL", color=color.red, style=plot.style_linebr)

// Shapes on entry
plotshape(event == "LONG_ENTRY", "LONG Entry Arrow", shape.arrowup, location.belowbar, color.lime, size=size.normal)
plotshape(event == "SHORT_ENTRY", "SHORT Entry Arrow", shape.arrowdown, location.abovebar, color.red, size=size.normal)
plotshape(event == "LONG_TP_HIT" or event == "SHORT_TP_HIT", "TP Hit Shape", shape.xcross, location.abovebar, color.yellow, size=size.normal)
plotshape(event == "LONG_SL_HIT" or event == "SHORT_SL_HIT", "SL Hit Shape", shape.xcross, location.belowbar, color.orange, size=size.normal)

// S/R levels
plot(rst, "Resistance Level", color=color.rgb(255, 0, 0, 80), style=plot.style_stepline)
plot(sup, "Support Level", color=color.rgb(0, 255, 0, 80), style=plot.style_stepline)
